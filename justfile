# Golem development tasks. `just` lists them.
# Recipes drop an inherited VIRTUAL_ENV so uv uses this repository's `.venv`.

set shell := ["env", "-u", "VIRTUAL_ENV", "bash", "-cu"]

# List recipes.
[private]
default:
    @just --list

# Make this checkout ready: check the tools, install the packages and hooks. Flags: --install, --check.
setup *flags:
    scripts/setup.sh {{flags}}

# Use the repository's git hooks (.githooks/), which check commit messages.
hooks:
    git config core.hooksPath .githooks

# Protect main on GitHub with scripts/github_ruleset.json and squash-only merges (gh as an admin).
protect:
    #!/usr/bin/env bash
    set -euo pipefail
    repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner)
    gh api --method PATCH "repos/$repo" --silent \
      -F allow_squash_merge=true -F allow_merge_commit=false -F allow_rebase_merge=false \
      -F delete_branch_on_merge=true -F allow_update_branch=true \
      -f squash_merge_commit_title=PR_TITLE -f squash_merge_commit_message=BLANK
    id=$(gh api "repos/$repo/rulesets" --jq '.[] | select(.name == "main") | .id')
    if [ -n "$id" ]; then
      gh api --method PUT "repos/$repo/rulesets/$id" --input scripts/github_ruleset.json --silent
    else
      gh api --method POST "repos/$repo/rulesets" --input scripts/github_ruleset.json --silent
    fi
    printf 'main on %s: pull requests only, squash merge, checks check, dist, pr-title.\n' "$repo"

# Export protocol JSON Schema and generate TypeScript from it.
gen:
    #!/usr/bin/env bash
    set -euo pipefail
    unset VIRTUAL_ENV
    uv run python -m golem_protocol.codegen
    rm -f packages/protocol/gen/*.ts
    for schema in packages/protocol/gen/*.schema.json; do
      stem="$(basename "$schema" .schema.json)"
      pnpm exec json2ts \
        --input "$schema" \
        --output "packages/protocol/gen/${stem}.ts" \
        --style.singleQuote \
        --unreachableDefinitions \
        --bannerComment '/* Generated by `just gen` from golem_protocol models. Do not edit. */'
    done
    uv run python -c 'from golem_protocol.codegen import default_gen_dir, export_browser_methods, export_version; export_version(default_gen_dir()); export_browser_methods(default_gen_dir())'

# Refresh the bundled copy of LiteLLM's model prices.
prices:
    uv run python -m golem.models.prices

# Check the local model catalog against the Ollama registry and list newer releases.
catalog:
    uv run python -m golem.models.catalog_check

# Lint Python and the TypeScript packages.
lint:
    uv run ruff check packages
    uv run ruff format --check packages
    pnpm -r --if-present lint

# Format Python.
fmt:
    uv run ruff format packages
    uv run ruff check --fix packages

# Typecheck Python (strict) and the TypeScript packages.
typecheck:
    uv run pyright
    pnpm -r --if-present typecheck

# Run tests.
test:
    uv run pytest
    pnpm -r --if-present test

# Run the golem CLI (--version, status, daemon install|start|stop|logs).
golem *args:
    pnpm exec golem {{args}}

# Open the TUI in the folder just was run from, so its session works there.
[no-cd]
tui:
    TSX_TSCONFIG_PATH="{{justfile_directory()}}/packages/tui/tsconfig.json" "{{justfile_directory()}}/packages/tui/node_modules/.bin/tsx" "{{justfile_directory()}}/packages/tui/src/main.tsx"

# Build dist/golem-<version>-<os>-<arch>: a frozen daemon and one golem binary.
dist:
    sh scripts/dist.sh

# Pack a built tree into a .tar.gz and its .sha256. Pass a path, or use the newest tree under dist/.
package tree="":
    sh scripts/package.sh {{tree}}

# Verify every signature in a built tree. Pass a path, or use the newest tree under dist/.
# `--identity-hash <sha1>` also requires that certificate.
check-signature tree="" *flags:
    python3 scripts/sign_dist.py check {{ if tree == "" { `ls -td dist/golem-*/ 2>/dev/null | head -n 1` } else { tree } }} {{flags}}

# Chat once against a built tree. Pass a path, or use the newest tree under dist/.
smoke-dist tree="":
    .venv/bin/python scripts/smoke_dist.py {{tree}}

# Show what the next release's notes would say, from the commits since the last tag.
changelog:
    uv run git-cliff --unreleased --strip all

# Open the release PR: CHANGELOG.md gets the new version's section. No version: work it out from the commits.
release version="":
    #!/usr/bin/env bash
    set -euo pipefail
    unset VIRTUAL_ENV
    fail() { printf 'just release: %s\n' "$1" >&2; exit 1; }
    git fetch --quiet --tags origin
    [ "$(git rev-parse --abbrev-ref HEAD)" = main ] || fail "switch to main first"
    [ -z "$(git status --porcelain --untracked-files=no)" ] || fail "commit or stash your changes first"
    [ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || fail "main is not origin/main: git pull first"
    version="{{ version }}"
    [ -n "$version" ] || version=$(uv run git-cliff --bumped-version 2>/dev/null)
    version=${version#v}
    printf '%s\n' "$version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$' \
      || fail "$version is not a version like 0.2.0 or 0.2.0-rc.1"
    tag="v$version"
    ! git rev-parse --quiet --verify "refs/tags/$tag" > /dev/null || fail "$tag already exists"
    branch="release/$tag"
    git switch --quiet -c "$branch"
    if ! sh scripts/changelog.sh add "$version"; then
      git switch --quiet main && git branch --quiet -D "$branch"
      exit 1
    fi
    git add CHANGELOG.md
    git commit --quiet -m "chore(release): $tag"
    git push --quiet -u origin "$branch"
    gh pr create --base main --head "$branch" --title "chore(release): $tag" --body "$(printf '%s\n' \
      "The release notes for golem $version: the new section in \`CHANGELOG.md\`. Edit them on this branch if they need it." \
      "" \
      "After this merges, run \`just tag\` on an up-to-date \`main\`. The tag starts the release (docs/sre.md, section 5).")"
    git switch --quiet main
    printf 'Review and merge the PR, then: git pull && just tag\n'

# Tag the merged release commit on main and push it, which starts the release. A version retries one on a fixed main.
tag version="":
    #!/usr/bin/env bash
    set -euo pipefail
    fail() { printf 'just tag: %s\n' "$1" >&2; exit 1; }
    git fetch --quiet --tags origin
    [ "$(git rev-parse --abbrev-ref HEAD)" = main ] || fail "switch to main first"
    [ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || fail "main is not origin/main: git pull first"
    tag="{{ version }}"
    if [ -n "$tag" ]; then
      tag="v${tag#v}"
    else
      subject=$(git log -1 --format=%s)
      tag=$(printf '%s\n' "$subject" | sed -nE 's/^chore\(release\): (v[^ ]+)( \(#[0-9]+\))?$/\1/p')
      [ -n "$tag" ] || fail "the last commit on main is not a release ($subject). Run just release and merge its PR first"
    fi
    ! git rev-parse --quiet --verify "refs/tags/$tag" > /dev/null || fail "$tag already exists"
    sh scripts/changelog.sh notes "$tag" > /dev/null
    git tag -a "$tag" -m "golem ${tag#v}"
    git push --quiet origin "$tag"
    printf '%s pushed. The release runs at %s/actions/workflows/release.yml\n' \
      "$tag" "$(gh repo view --json url --jq .url)"

# Lint, typecheck, test, and fail if generated protocol files drift.
check:
    #!/usr/bin/env bash
    set -euo pipefail
    unset VIRTUAL_ENV
    snapshot="$(mktemp -d)"
    trap 'rm -rf "$snapshot"' EXIT
    mkdir -p packages/protocol/gen
    cp -R packages/protocol/gen/. "$snapshot/"
    just gen
    if ! diff -ru "$snapshot" packages/protocol/gen; then
      printf 'packages/protocol/gen drifted from the protocol models. Commit the regenerated files.\n' >&2
      exit 1
    fi
    just lint
    just typecheck
    just test
