# Golem development tasks. `just` lists them.
# Recipes drop an inherited VIRTUAL_ENV so uv uses this repository's `.venv`.

set shell := ["env", "-u", "VIRTUAL_ENV", "bash", "-cu"]

# List recipes.
[private]
default:
    @just --list

# Make this checkout ready: check the tools, install the packages and hooks. Flags: --install, --check.
setup *flags:
    scripts/setup.sh {{flags}}

# Use the repository's git hooks (.githooks/), which check commit messages.
hooks:
    git config core.hooksPath .githooks

# Protect main on GitHub with scripts/github_ruleset.json and squash-only merges (gh as an admin).
protect:
    #!/usr/bin/env bash
    set -euo pipefail
    repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner)
    gh api --method PATCH "repos/$repo" --silent \
      -F allow_squash_merge=true -F allow_merge_commit=false -F allow_rebase_merge=false \
      -F delete_branch_on_merge=true -F allow_update_branch=true \
      -f squash_merge_commit_title=PR_TITLE -f squash_merge_commit_message=BLANK
    id=$(gh api "repos/$repo/rulesets" --jq '.[] | select(.name == "main") | .id')
    if [ -n "$id" ]; then
      gh api --method PUT "repos/$repo/rulesets/$id" --input scripts/github_ruleset.json --silent
    else
      gh api --method POST "repos/$repo/rulesets" --input scripts/github_ruleset.json --silent
    fi
    printf 'main on %s: pull requests only, squash merge, checks check, dist, pr-title.\n' "$repo"

# Export protocol JSON Schema and generate TypeScript from it.
gen:
    #!/usr/bin/env bash
    set -euo pipefail
    unset VIRTUAL_ENV
    uv run python -m golem_protocol.codegen
    rm -f packages/protocol/gen/*.ts
    # One json2ts per schema, as many at once as the machine has cores.
    export BANNER='/* Generated by `just gen` from golem_protocol models. Do not edit. */'
    printf '%s\0' packages/protocol/gen/*.schema.json | xargs -0 -n 1 -P "$(getconf _NPROCESSORS_ONLN)" sh -c '
      pnpm exec json2ts \
        --input "$1" \
        --output "${1%.schema.json}.ts" \
        --style.singleQuote \
        --unreachableDefinitions \
        --bannerComment "$BANNER"' _
    uv run python -c 'from golem_protocol.codegen import default_gen_dir, export_browser_methods, export_device_methods, export_version; export_version(default_gen_dir()); export_browser_methods(default_gen_dir()); export_device_methods(default_gen_dir())'
    # Swift for GolemKit: one quicktype run over all the schemas (Node only, so Linux CI runs it too).
    swift_dir=apps/apple/GolemKit/Sources/GolemKit/Generated
    mkdir -p "$swift_dir"
    rm -f "$swift_dir"/*.swift
    raw="$(mktemp)"
    trap 'rm -f "$raw"' EXIT
    pnpm exec quicktype --src-lang schema --lang swift --access-level public \
      --struct-or-class struct --density normal --no-initializers --quiet \
      --out "$raw" packages/protocol/gen/*.schema.json 2>/dev/null
    {
      printf '%s\n' '// Generated by `just gen` from golem_protocol. Do not edit.' ''
      sed -n '/^import Foundation/,$p' "$raw"
    } > "$swift_dir/Protocol.swift"
    uv run python -c 'from golem_protocol.codegen import default_swift_dir, export_swift_methods, export_swift_version; export_swift_version(default_swift_dir()); export_swift_methods(default_swift_dir())'

# Run GolemKit's tests. Needs a Mac with Swift; `just gen` first if the schemas changed.
swift-check:
    #!/usr/bin/env bash
    set -euo pipefail
    cd apps/apple/GolemKit
    dev="$(xcode-select -p)"
    if [[ "$dev" == */CommandLineTools ]]; then
        # Without Xcode, Swift Testing lives in the Command Line Tools' own frameworks folder.
        fw="$dev/Library/Developer/Frameworks"
        lib="$dev/Library/Developer/usr/lib"
        swift test -Xswiftc -F -Xswiftc "$fw" -Xlinker -F -Xlinker "$fw" \
            -Xlinker -rpath -Xlinker "$fw" -Xlinker -rpath -Xlinker "$lib"
    else
        swift test
    fi

# Record the event logs the view package tests fold: a real daemon, a fake model, six chats.
golden:
    uv run python packages/daemon/tests/golden.py

# Refresh the bundled copy of LiteLLM's model prices.
prices:
    uv run python -m golem.models.prices

# Check the local model catalog against the Ollama registry, and the MCP catalog against npm and PyPI.
catalog:
    uv run python -m golem.models.catalog_check
    uv run python -m golem.mcp.catalog_check

# Lint Python and the TypeScript packages.
lint:
    uv run ruff check packages
    uv run ruff format --check packages
    pnpm -r --if-present lint

# Format Python.
fmt:
    uv run ruff format packages
    uv run ruff check --fix packages

# Typecheck Python (strict) and the TypeScript packages.
typecheck:
    uv run pyright
    pnpm -r --if-present typecheck

# Run tests.
test:
    just test-py
    just test-js
    just test-web

# The Python tests.
test-py:
    uv run pytest

# Print the routing cases as a Markdown table, for "Routing a turn" in docs/architecture/models.md.
routing-table:
    @uv run python packages/daemon/tests/routing_table.py

# The tests of every TypeScript package but the web app.
test-js:
    pnpm -r --filter '!@golem/web' --if-present test

# The web app's tests. CI passes a shard, such as `just test-web 2/4`.
test-web shard="1/1":
    pnpm --filter @golem/web test --shard={{shard}}

# Run the relay for development on 127.0.0.1:8080. Set RELAY_HOST (the name clients sign for) or BIND to change them.
relay:
    RELAY_HOST="${RELAY_HOST:-localhost}" BIND="${BIND:-127.0.0.1:8080}" bun packages/relay/src/bun/main.ts

# Serve the docs site at http://localhost:5173/golem/, reloading on every edit (ADR-034).
docs:
    pnpm --filter @golem/docs dev

# Redraw the web app's icons (packages/web/public/*.png) from the pixel golem. Commit the result.
icons:
    bun packages/web/scripts/gen-icons.ts

# Build the static gallery of every web component into packages/web/dist-gallery. The docs site publishes it at /gallery/.
gallery-build:
    pnpm --filter @golem/web build:gallery

# Build the docs site, with the gallery, into docs/.vitepress/dist. A dead link fails the build.
docs-build:
    pnpm --filter @golem/docs build

# Record the terminal demo into docs/images/demo-tui.*: the real TUI and daemon, a scripted model. Needs vhs and cargo.
demo-tui:
    sh scripts/demo/tui.sh

# Record the three web UI demos into docs/images/demo-{search,code,inbox}.*: the real web UI and daemon, a scripted model. Needs cargo. Name clips to record only those.
demo-web *clips:
    sh scripts/demo/web.sh {{clips}}

# Run the golem CLI (--version, status, daemon install|start|stop|logs). Quoted arguments stay one argument.
[positional-arguments]
golem *args:
    pnpm exec golem "$@"

# Open the TUI in the folder just was run from, so its session works there.
[no-cd]
tui:
    TSX_TSCONFIG_PATH="{{justfile_directory()}}/packages/tui/tsconfig.json" "{{justfile_directory()}}/packages/tui/node_modules/.bin/tsx" "{{justfile_directory()}}/packages/tui/src/dev.tsx"

# Build dist/golem-<version>-<os>-<arch>: a frozen daemon and one golem binary.
dist:
    sh scripts/dist.sh

# Pack a built tree into a .tar.gz and its .sha256. Pass a path, or use the newest tree under dist/.
package tree="":
    sh scripts/package.sh {{tree}}

# Verify every signature in a built tree. Pass a path, or use the newest tree under dist/.
# `--identity-hash <sha1>` also requires that certificate.
check-signature tree="" *flags:
    python3 scripts/sign_dist.py check {{ if tree == "" { `ls -td dist/golem-*/ 2>/dev/null | head -n 1` } else { tree } }} {{flags}}

# Chat once against a built tree. Pass a path, or use the newest tree under dist/.
smoke-dist tree="":
    .venv/bin/python scripts/smoke_dist.py {{tree}}

# Show what the next release's notes would say, from the commits since the last tag.
changelog:
    uv run git-cliff --unreleased --strip all

# Open the release PR: CHANGELOG.md gets the new version's section. No version: work it out from the commits.
release version="":
    #!/usr/bin/env bash
    set -euo pipefail
    unset VIRTUAL_ENV
    fail() { printf 'just release: %s\n' "$1" >&2; exit 1; }
    git fetch --quiet --tags origin
    [ "$(git rev-parse --abbrev-ref HEAD)" = main ] || fail "switch to main first"
    [ -z "$(git status --porcelain --untracked-files=no)" ] || fail "commit or stash your changes first"
    [ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || fail "main is not origin/main: git pull first"
    version="{{ version }}"
    [ -n "$version" ] || version=$(uv run git-cliff --bumped-version 2>/dev/null)
    version=${version#v}
    printf '%s\n' "$version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$' \
      || fail "$version is not a version like 0.2.0 or 0.2.0-rc.1"
    tag="v$version"
    ! git rev-parse --quiet --verify "refs/tags/$tag" > /dev/null || fail "$tag already exists"
    branch="release/$tag"
    git switch --quiet -c "$branch"
    if ! sh scripts/changelog.sh add "$version"; then
      git switch --quiet main && git branch --quiet -D "$branch"
      exit 1
    fi
    git add CHANGELOG.md
    git commit --quiet -m "chore(release): $tag"
    git push --quiet -u origin "$branch"
    gh pr create --base main --head "$branch" --title "chore(release): $tag" --body "$(printf '%s\n' \
      "The release notes for golem $version: the new section in \`CHANGELOG.md\`. Edit them on this branch if they need it." \
      "" \
      "After this merges, run \`just tag\` on an up-to-date \`main\`. The tag starts the release (docs/ops/release.md, Releases).")"
    git switch --quiet main
    printf 'Review and merge the PR, then: git pull && just tag\n'

# Tag the merged release commit on main and push it, which starts the release. A version retries one on a fixed main.
tag version="":
    #!/usr/bin/env bash
    set -euo pipefail
    fail() { printf 'just tag: %s\n' "$1" >&2; exit 1; }
    git fetch --quiet --tags origin
    [ "$(git rev-parse --abbrev-ref HEAD)" = main ] || fail "switch to main first"
    [ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || fail "main is not origin/main: git pull first"
    tag="{{ version }}"
    if [ -n "$tag" ]; then
      tag="v${tag#v}"
    else
      subject=$(git log -1 --format=%s)
      tag=$(printf '%s\n' "$subject" | sed -nE 's/^chore\(release\): (v[^ ]+)( \(#[0-9]+\))?$/\1/p')
      [ -n "$tag" ] || fail "the last commit on main is not a release ($subject). Run just release and merge its PR first"
    fi
    ! git rev-parse --quiet --verify "refs/tags/$tag" > /dev/null || fail "$tag already exists"
    sh scripts/changelog.sh notes "$tag" > /dev/null
    git tag -a "$tag" -m "golem ${tag#v}"
    git push --quiet origin "$tag"
    printf '%s pushed. The release runs at %s/actions/workflows/release.yml\n' \
      "$tag" "$(gh repo view --json url --jq .url)"

# Run the web page's end-to-end tests in Chrome: a real daemon, gateway, and page.
e2e:
    pnpm --filter @golem/web e2e

# Fail if the generated protocol files drift from the models.
check-gen:
    #!/usr/bin/env bash
    set -euo pipefail
    unset VIRTUAL_ENV
    snapshot="$(mktemp -d)"
    trap 'rm -rf "$snapshot"' EXIT
    swift_dir=apps/apple/GolemKit/Sources/GolemKit/Generated
    mkdir -p packages/protocol/gen "$swift_dir" "$snapshot/gen" "$snapshot/swift"
    cp -R packages/protocol/gen/. "$snapshot/gen/"
    cp -R "$swift_dir/." "$snapshot/swift/"
    just gen
    if ! diff -ru "$snapshot/gen" packages/protocol/gen; then
      printf 'packages/protocol/gen drifted from the protocol models. Commit the regenerated files.\n' >&2
      exit 1
    fi
    if ! diff -ru "$snapshot/swift" "$swift_dir"; then
      printf '%s drifted from the protocol schemas. Run just gen and commit the Swift files.\n' "$swift_dir" >&2
      exit 1
    fi

# Lint, typecheck, test, and fail if generated protocol files drift. CI runs the same parts as parallel jobs.
check:
    just check-gen
    just lint
    just typecheck
    just test
    just docs-build
