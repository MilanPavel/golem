{
  "$defs": {
    "WorkflowOutput": {
      "additionalProperties": false,
      "description": "One result a run marked with ``run.output``.\n\n``value`` is the JSON given (text, a record, rows, a file path or a URL).",
      "properties": {
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "value": {
          "default": null,
          "title": "Value"
        }
      },
      "title": "WorkflowOutput",
      "type": "object"
    },
    "WorkflowRunOrigin": {
      "additionalProperties": false,
      "description": "Where a run started again from a step came from.",
      "properties": {
        "started_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "step_key": {
          "minLength": 1,
          "title": "Step Key",
          "type": "string"
        },
        "step_number": {
          "minimum": 1,
          "title": "Step Number",
          "type": "integer"
        },
        "step_title": {
          "title": "Step Title",
          "type": "string"
        },
        "workflow_run_id": {
          "minLength": 1,
          "title": "Workflow Run Id",
          "type": "string"
        }
      },
      "required": [
        "workflow_run_id",
        "step_key",
        "step_title",
        "step_number"
      ],
      "title": "WorkflowRunOrigin",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One run of a workflow, from its ``workflow_runs`` row.\n\nThe times are ISO 8601 with an offset. ``session_id`` is the run's headless session, null\nuntil a step needs one. ``error`` says why a ``failed`` run failed.",
  "properties": {
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "from_run": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkflowRunOrigin"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "inputs": {
      "additionalProperties": true,
      "title": "Inputs",
      "type": "object"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "outputs": {
      "items": {
        "$ref": "#/$defs/WorkflowOutput"
      },
      "title": "Outputs",
      "type": "array"
    },
    "result": {
      "default": null,
      "title": "Result"
    },
    "session_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    },
    "started_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "enum": [
        "pending",
        "running",
        "waiting",
        "done",
        "failed",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "steps_expected": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Steps Expected"
    },
    "summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Summary"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "trigger": {
      "title": "Trigger",
      "type": "string"
    },
    "usual_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Usual Ms"
    },
    "workflow_id": {
      "minLength": 1,
      "title": "Workflow Id",
      "type": "string"
    },
    "workflow_run_id": {
      "minLength": 1,
      "title": "Workflow Run Id",
      "type": "string"
    }
  },
  "required": [
    "workflow_run_id",
    "workflow_id",
    "name",
    "status",
    "trigger"
  ],
  "title": "WorkflowRunInfo",
  "type": "object"
}
