{
  "$defs": {
    "AgentLimits": {
      "additionalProperties": false,
      "description": "What bounds one helper of this type. ``None`` means the file sets no limit of that kind.\n\n``max_seconds`` is working time: it does not count the time spent waiting for\nyou, for a slot or for a provider. ``answer_chars`` cuts the helper's final answer.",
      "properties": {
        "answer_chars": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer Chars"
        },
        "max_calls": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Calls"
        },
        "max_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Usd"
        },
        "max_seconds": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Seconds"
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        }
      },
      "title": "AgentLimits",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The agent type and its prompt, the body of its file.",
  "properties": {
    "asks": {
      "default": false,
      "title": "Asks",
      "type": "boolean"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    },
    "finished": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished"
    },
    "limits": {
      "$ref": "#/$defs/AgentLimits"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "origin": {
      "enum": [
        "bundled",
        "user",
        "project"
      ],
      "title": "Origin",
      "type": "string"
    },
    "prompt": {
      "title": "Prompt",
      "type": "string"
    },
    "shadowed": {
      "items": {
        "enum": [
          "bundled",
          "user",
          "project"
        ],
        "type": "string"
      },
      "title": "Shadowed",
      "type": "array"
    },
    "tools": {
      "items": {
        "type": "string"
      },
      "title": "Tools",
      "type": "array"
    },
    "trusted": {
      "default": true,
      "title": "Trusted",
      "type": "boolean"
    },
    "used": {
      "default": 0,
      "minimum": 0,
      "title": "Used",
      "type": "integer"
    },
    "wish": {
      "minLength": 1,
      "title": "Wish",
      "type": "string"
    }
  },
  "required": [
    "name",
    "description",
    "origin",
    "wish",
    "prompt"
  ],
  "title": "AgentsGetResult",
  "type": "object"
}
