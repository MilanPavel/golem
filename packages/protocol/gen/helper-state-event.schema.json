{
  "$defs": {
    "HelperStateData": {
      "additionalProperties": false,
      "description": "A helper queued, started running, started waiting, or went on.\n\n``reason`` says why it waits or queues. It is a plain string, not a fixed list: the\nwords today are ``you`` and ``team``, and later phases add more, so a new word is not\na protocol change. It is None when the helper runs with nothing to explain.",
      "properties": {
        "call_id": {
          "minLength": 1,
          "title": "Call Id",
          "type": "string"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "waiting"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "call_id",
        "index",
        "state"
      ],
      "title": "HelperStateData",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A helper queued, started running, started waiting, or went on.",
  "properties": {
    "data": {
      "$ref": "#/$defs/HelperStateData"
    },
    "run_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "seq": {
      "minimum": 1,
      "title": "Seq",
      "type": "integer"
    },
    "session_id": {
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "ts": {
      "minLength": 1,
      "title": "Ts",
      "type": "string"
    },
    "type": {
      "const": "helper.state",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "seq",
    "session_id",
    "ts",
    "type",
    "data"
  ],
  "title": "HelperStateEvent",
  "type": "object"
}
