{
  "$defs": {
    "ListedModel": {
      "additionalProperties": false,
      "description": "One model, by ``provider/model`` ref.\n\n``source`` is where golem found it: ``installed`` on a local server,\n``catalog`` for a local model to download, ``remote`` from a provider's\nlist, or ``profile`` when only config names it. ``progress`` is set while\nit is ``pulling``. ``profiles`` are the profile names that point at it.\n``fit`` says whether a local model fits in this machine's memory.\n``tags`` are a catalog model's tags, such as ``coding``, and\n``recommended`` marks the one catalog model golem suggests for this Mac.\n``categories`` say what the model is for, in a fixed order: the catalog's\nown for a model it lists, else what Ollama's ``capabilities`` and\nLiteLLM's ``supports_*`` fields and context size show.\n``recommended_for`` lists the categories this catalog model is the pick for on\nthis Mac: the largest model of that category it has the memory for.\n``think_values`` is what the ``think`` option takes for this model: ``off`` and\n``on``, or ``low``, ``medium`` and ``high``. It is empty when the model cannot think.\n``stale`` means a cached list was shown because the provider did not\nanswer in time.",
      "properties": {
        "categories": {
          "items": {
            "enum": [
              "general",
              "coding",
              "reasoning",
              "vision",
              "fast",
              "long-context"
            ],
            "type": "string"
          },
          "title": "Categories",
          "type": "array"
        },
        "ctx": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ctx"
        },
        "fit": {
          "anyOf": [
            {
              "enum": [
                "fits",
                "tight",
                "too_big"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fit"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "price": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelPriceInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "profiles": {
          "items": {
            "type": "string"
          },
          "title": "Profiles",
          "type": "array"
        },
        "progress": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Progress"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "recommended": {
          "default": false,
          "title": "Recommended",
          "type": "boolean"
        },
        "recommended_for": {
          "items": {
            "enum": [
              "general",
              "coding",
              "reasoning",
              "vision",
              "fast",
              "long-context"
            ],
            "type": "string"
          },
          "title": "Recommended For",
          "type": "array"
        },
        "ref": {
          "minLength": 3,
          "title": "Ref",
          "type": "string"
        },
        "size_gb": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Gb"
        },
        "source": {
          "enum": [
            "installed",
            "catalog",
            "remote",
            "profile"
          ],
          "title": "Source",
          "type": "string"
        },
        "stale": {
          "default": false,
          "title": "Stale",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "ready",
            "needs_key",
            "not_installed",
            "server_down",
            "pulling"
          ],
          "title": "Status",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "think_values": {
          "items": {
            "type": "string"
          },
          "title": "Think Values",
          "type": "array"
        },
        "tools": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tools"
        }
      },
      "required": [
        "ref",
        "label",
        "provider",
        "source",
        "status"
      ],
      "title": "ListedModel",
      "type": "object"
    },
    "ListedProvider": {
      "additionalProperties": false,
      "description": "``unlisted`` is a provider golem does not ask for models: nothing uses it yet.\n\n``not_installed`` is a local server whose program is missing, such as an\nOllama with no ``ollama`` binary on this machine.",
      "properties": {
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "stale": {
          "default": false,
          "title": "Stale",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "ready",
            "needs_key",
            "server_down",
            "not_installed",
            "unlisted"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "status"
      ],
      "title": "ListedProvider",
      "type": "object"
    },
    "ModelPriceInfo": {
      "additionalProperties": false,
      "description": "USD per million tokens. A local model is zero.",
      "properties": {
        "cached_input": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cached Input"
        },
        "input": {
          "minimum": 0,
          "title": "Input",
          "type": "number"
        },
        "output": {
          "minimum": 0,
          "title": "Output",
          "type": "number"
        }
      },
      "required": [
        "input",
        "output"
      ],
      "title": "ModelPriceInfo",
      "type": "object"
    },
    "ModelSetup": {
      "additionalProperties": false,
      "description": "Where the user is in setting up a model, for a first-run screen.\n\n``keys`` are the providers with a key, from the environment or the\nKeychain. ``default_status`` is the default model's status, ``unknown``\nwhen it names a model golem does not list, and null when no default is\nchosen. ``ollama_stray`` is true when a local Ollama answers but no\n``ollama`` binary is installed: a server left from a removed install, which\nlists its models and cannot load them. It is then neither installed nor\nrunning here.",
      "properties": {
        "default_status": {
          "anyOf": [
            {
              "enum": [
                "ready",
                "needs_key",
                "not_installed",
                "server_down",
                "pulling",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Status"
        },
        "keys": {
          "items": {
            "type": "string"
          },
          "title": "Keys",
          "type": "array"
        },
        "ollama_installed": {
          "title": "Ollama Installed",
          "type": "boolean"
        },
        "ollama_running": {
          "title": "Ollama Running",
          "type": "boolean"
        },
        "ollama_stray": {
          "default": false,
          "title": "Ollama Stray",
          "type": "boolean"
        }
      },
      "required": [
        "ollama_installed",
        "ollama_running"
      ],
      "title": "ModelSetup",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``default`` is the model a new session gets, null before one is chosen.\n\n``ram_gb`` is this machine's memory, and ``disk_free_gb`` the free space\nin the home folder, where Ollama keeps its models.",
  "properties": {
    "default": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Default"
    },
    "disk_free_gb": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Disk Free Gb"
    },
    "models": {
      "items": {
        "$ref": "#/$defs/ListedModel"
      },
      "title": "Models",
      "type": "array"
    },
    "providers": {
      "items": {
        "$ref": "#/$defs/ListedProvider"
      },
      "title": "Providers",
      "type": "array"
    },
    "ram_gb": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ram Gb"
    },
    "setup": {
      "$ref": "#/$defs/ModelSetup"
    }
  },
  "required": [
    "default",
    "models",
    "providers",
    "setup"
  ],
  "title": "ModelListResult",
  "type": "object"
}
