{
  "$defs": {
    "RevertTarget": {
      "additionalProperties": false,
      "description": "What ``changes.revert`` takes back. Each kind needs its own field and no other.\n\n``change`` needs ``change_id``, ``file`` needs ``path``, ``hunk`` needs ``path`` and\n``hunk`` (0-based, of the file's net diff), and ``run`` needs ``run_id``.",
      "properties": {
        "change_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Change Id"
        },
        "hunk": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hunk"
        },
        "kind": {
          "enum": [
            "change",
            "file",
            "hunk",
            "run"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "run_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        }
      },
      "required": [
        "kind"
      ],
      "title": "RevertTarget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``changes.revert``. Put back what a change, a file, a hunk or a turn wrote.\n\nWithout ``force``, a file that changed on disk since golem wrote it is left alone\nand listed as a conflict. Refused while the session has a run.",
  "properties": {
    "force": {
      "default": false,
      "title": "Force",
      "type": "boolean"
    },
    "session_id": {
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/RevertTarget"
    }
  },
  "required": [
    "session_id",
    "target"
  ],
  "title": "ChangesRevertParams",
  "type": "object"
}
