{
  "$defs": {
    "PromptSectionInfo": {
      "additionalProperties": false,
      "description": "One non-empty section of the system prompt sent with a model call.\n\n``chars`` is the length of the section's text after strip, counted as\nPython counts it (Unicode code points). The prompt is the sections' texts,\nin order, joined with \"\\n\\n\", so the lengths split the stored prompt\nexactly.",
      "properties": {
        "chars": {
          "minimum": 0,
          "title": "Chars",
          "type": "integer"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "chars"
      ],
      "title": "PromptSectionInfo",
      "type": "object"
    },
    "TraceContext": {
      "additionalProperties": false,
      "description": "What filled one model call's context, and how big the window was.\n\n``parts`` always has the five keys, in order. They add up to ``used``\nwhen it is known. The split between them is an estimate (about four\ncharacters a token, scaled to ``used``), so ``estimated`` is always true.\nThe ``prompt_cut`` fields are those of the model span.",
      "properties": {
        "dropped_message_ids": {
          "items": {
            "type": "string"
          },
          "title": "Dropped Message Ids",
          "type": "array"
        },
        "dropped_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dropped Tokens"
        },
        "estimated": {
          "default": true,
          "title": "Estimated",
          "type": "boolean"
        },
        "num_ctx": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Num Ctx"
        },
        "parts": {
          "items": {
            "$ref": "#/$defs/TraceContextPart"
          },
          "title": "Parts",
          "type": "array"
        },
        "prompt_cut": {
          "anyOf": [
            {
              "enum": [
                "no",
                "yes",
                "likely"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Cut"
        },
        "prompt_cut_kind": {
          "anyOf": [
            {
              "enum": [
                "older_messages",
                "middle"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Cut Kind"
        },
        "used": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Used"
        },
        "window": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window"
        },
        "window_estimated": {
          "default": false,
          "title": "Window Estimated",
          "type": "boolean"
        }
      },
      "required": [
        "parts"
      ],
      "title": "TraceContext",
      "type": "object"
    },
    "TraceContextItem": {
      "additionalProperties": false,
      "description": "One tool or one prompt section, with its share of the tokens.",
      "properties": {
        "group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "tokens": {
          "minimum": 0,
          "title": "Tokens",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "tokens"
      ],
      "title": "TraceContextItem",
      "type": "object"
    },
    "TraceContextPart": {
      "additionalProperties": false,
      "description": "One kind of content in the context.",
      "properties": {
        "chars": {
          "minimum": 0,
          "title": "Chars",
          "type": "integer"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/TraceContextItem"
          },
          "title": "Items",
          "type": "array"
        },
        "key": {
          "enum": [
            "system",
            "tools",
            "user",
            "assistant",
            "tool_results"
          ],
          "title": "Key",
          "type": "string"
        },
        "tokens": {
          "minimum": 0,
          "title": "Tokens",
          "type": "integer"
        }
      },
      "required": [
        "key",
        "tokens",
        "chars"
      ],
      "title": "TraceContextPart",
      "type": "object"
    },
    "TraceMessage": {
      "additionalProperties": false,
      "description": "One checkpoint message with its id, as plain text.",
      "properties": {
        "call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Call Id"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "role": {
          "enum": [
            "user",
            "assistant",
            "tool"
          ],
          "title": "Role",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens"
        },
        "tool_calls": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Tool Calls",
          "type": "array"
        }
      },
      "required": [
        "role",
        "text"
      ],
      "title": "TraceMessage",
      "type": "object"
    },
    "TraceSpan": {
      "additionalProperties": false,
      "description": "One run, model call, or tool call, without its children.\n\n``id`` is the run id for a run, the assistant ``message_id`` for a model\ncall, and the ``call_id`` for a tool call. ``end`` is null while the span\nis open, or when its run was cut off. ``duration_ms`` is the model's\nlatency or the tool's own time when the daemon measured it, else\n``end - start``. ``approval_wait_ms`` is the time a tool call waited for\nthe user. ``recorded`` is false for a model span rebuilt from the message\nevents of a session that has no ``model.call.*`` events.",
      "properties": {
        "approval_wait_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approval Wait Ms"
        },
        "duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "first_token_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Token Ms"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "run",
            "model",
            "tool"
          ],
          "title": "Kind",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "preview": {
          "default": "",
          "maxLength": 200,
          "title": "Preview",
          "type": "string"
        },
        "recorded": {
          "default": true,
          "title": "Recorded",
          "type": "boolean"
        },
        "start": {
          "minLength": 1,
          "title": "Start",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "failed",
            "cancelled",
            "denied",
            "running"
          ],
          "title": "Status",
          "type": "string"
        },
        "tokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/TraceTokens"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "start",
        "status"
      ],
      "title": "TraceSpan",
      "type": "object"
    },
    "TraceTokens": {
      "additionalProperties": false,
      "description": "Tokens one model call used. A field is null when the provider did not report it.",
      "properties": {
        "cache_read": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Read"
        },
        "cache_write": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Write"
        },
        "input": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input"
        },
        "output": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output"
        }
      },
      "title": "TraceTokens",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "What a span took in and gave out. ``span`` has no children.\n\nFor a model span, ``messages`` is the context sent, in order, and\n``new_from`` is where the part new since the previous model call\nbegins. ``system_prompt`` and ``tools`` are null when they were not\nrecorded. For a tool span, ``result`` is the text the model got back, and\n``artifact_id`` is set when the output was too big for the model: open it\nwith ``artifact.read``. ``context`` is set for every model span, and\n``system_sections`` is null when the call recorded none.",
  "properties": {
    "approval": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approval"
    },
    "args": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Args"
    },
    "artifact_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact Id"
    },
    "context": {
      "anyOf": [
        {
          "$ref": "#/$defs/TraceContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/TraceMessage"
      },
      "title": "Messages",
      "type": "array"
    },
    "new_from": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "New From"
    },
    "provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider"
    },
    "reply": {
      "anyOf": [
        {
          "$ref": "#/$defs/TraceMessage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "result": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result"
    },
    "span": {
      "$ref": "#/$defs/TraceSpan"
    },
    "stop_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stop Reason"
    },
    "system_prompt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "System Prompt"
    },
    "system_sections": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/PromptSectionInfo"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "System Sections"
    },
    "tools": {
      "anyOf": [
        {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tools"
    }
  },
  "required": [
    "span"
  ],
  "title": "TraceSpanResult",
  "type": "object"
}
