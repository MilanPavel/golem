{
  "$defs": {
    "ConfigError": {
      "additionalProperties": false,
      "description": "One problem in a config text. ``line`` and ``column`` count from 1, when known.\n\n``path`` is the setting, as ``mcp.github.headers.Authorization``.",
      "properties": {
        "column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        }
      },
      "required": [
        "message"
      ],
      "title": "ConfigError",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``ok`` is false when anything was wrong, and the file is then untouched.\n\n``restart_needed`` names the top-level sections that changed and are read\nonly when the daemon starts. ``mtime_ns`` is the new file's.",
  "properties": {
    "errors": {
      "items": {
        "$ref": "#/$defs/ConfigError"
      },
      "title": "Errors",
      "type": "array"
    },
    "mtime_ns": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mtime Ns"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "restart_needed": {
      "items": {
        "type": "string"
      },
      "title": "Restart Needed",
      "type": "array"
    }
  },
  "required": [
    "ok"
  ],
  "title": "ConfigRawResult",
  "type": "object"
}
