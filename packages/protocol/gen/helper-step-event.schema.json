{
  "$defs": {
    "HelperStepData": {
      "additionalProperties": false,
      "description": "A tool call of a helper started or ended.\n\nThin on purpose: the card shows what ran, and the helper's own log has the detail.\n``args`` holds only the path, pattern, query or ref of the call. ``step_id`` is the\nhelper's own tool call id. ``calls`` is how many tool calls the helper has made so far.",
      "properties": {
        "args": {
          "additionalProperties": true,
          "title": "Args",
          "type": "object"
        },
        "call_id": {
          "minLength": 1,
          "title": "Call Id",
          "type": "string"
        },
        "calls": {
          "minimum": 0,
          "title": "Calls",
          "type": "integer"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "running",
            "done",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "step_id": {
          "minLength": 1,
          "title": "Step Id",
          "type": "string"
        }
      },
      "required": [
        "call_id",
        "index",
        "step_id",
        "name",
        "status",
        "calls"
      ],
      "title": "HelperStepData",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A tool call of a helper started or ended.",
  "properties": {
    "data": {
      "$ref": "#/$defs/HelperStepData"
    },
    "run_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "seq": {
      "minimum": 1,
      "title": "Seq",
      "type": "integer"
    },
    "session_id": {
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "ts": {
      "minLength": 1,
      "title": "Ts",
      "type": "string"
    },
    "type": {
      "const": "helper.step",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "seq",
    "session_id",
    "ts",
    "type",
    "data"
  ],
  "title": "HelperStepEvent",
  "type": "object"
}
