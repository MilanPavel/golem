{
  "$defs": {
    "ConfigAllowance": {
      "additionalProperties": false,
      "description": "A tool allowed for the rest of the session asked about.",
      "properties": {
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        },
        "tool": {
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool"
      ],
      "title": "ConfigAllowance",
      "type": "object"
    },
    "ConfigLadder": {
      "additionalProperties": false,
      "description": "``[routing.ladder]``: the model named for each tier. Null means golem chooses.",
      "properties": {
        "budget": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget"
        },
        "frontier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frontier"
        },
        "local": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local"
        }
      },
      "title": "ConfigLadder",
      "type": "object"
    },
    "ConfigRouting": {
      "additionalProperties": false,
      "description": "What a route chip needs from ``[routing]`` and ``[budget]``.\n\n``daily_usd`` and ``session_usd`` are the caps on paid models, null for no cap.",
      "properties": {
        "daily_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Daily Usd"
        },
        "ladder": {
          "$ref": "#/$defs/ConfigLadder"
        },
        "session_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Usd"
        }
      },
      "title": "ConfigRouting",
      "type": "object"
    },
    "ConfigRule": {
      "additionalProperties": false,
      "description": "One tool rule, in the order rules are checked.\n\n``source`` names the file and the rule's number in it, or ``built-in\ndefault``. ``ignored`` says why a listed rule never matches. ``file`` and\n``index`` are what ``policy.update`` and ``policy.remove`` take.",
      "properties": {
        "action": {
          "enum": [
            "allow",
            "ask",
            "deny"
          ],
          "title": "Action",
          "type": "string"
        },
        "file": {
          "default": "default",
          "enum": [
            "user",
            "project",
            "default"
          ],
          "title": "File",
          "type": "string"
        },
        "ignored": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ignored"
        },
        "index": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Index"
        },
        "match": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Match"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "tool": {
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "action",
        "source"
      ],
      "title": "ConfigRule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Resolved settings. Keys are never included.\n\n``project_policy`` is the project's ``.golem/policy.toml`` when it exists,\nand ``project_trusted`` whether its allow rules count. Both are null\nwithout a ``cwd``. ``default_permission_mode`` is ``[permissions] mode``,\nand ``permission_mode`` the mode the ``rules`` were built for: the session's\nwhen ``session_id`` is given, else the default. An older daemon leaves both out.\n``routing`` is the ladder and the spending caps. An older daemon leaves it out.",
  "properties": {
    "config_file": {
      "minLength": 1,
      "title": "Config File",
      "type": "string"
    },
    "default_model": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Default Model"
    },
    "default_permission_mode": {
      "default": "balanced",
      "enum": [
        "careful",
        "balanced",
        "autopilot"
      ],
      "title": "Default Permission Mode",
      "type": "string"
    },
    "log_level": {
      "minLength": 1,
      "title": "Log Level",
      "type": "string"
    },
    "permission_mode": {
      "default": "balanced",
      "enum": [
        "careful",
        "balanced",
        "autopilot"
      ],
      "title": "Permission Mode",
      "type": "string"
    },
    "project_policy": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Policy"
    },
    "project_trusted": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Trusted"
    },
    "routing": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConfigRouting"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/ConfigRule"
      },
      "title": "Rules",
      "type": "array"
    },
    "session_allowed": {
      "items": {
        "$ref": "#/$defs/ConfigAllowance"
      },
      "title": "Session Allowed",
      "type": "array"
    },
    "session_titles": {
      "title": "Session Titles",
      "type": "boolean"
    },
    "trusted_projects": {
      "items": {
        "type": "string"
      },
      "title": "Trusted Projects",
      "type": "array"
    }
  },
  "required": [
    "config_file",
    "default_model",
    "log_level",
    "session_titles",
    "trusted_projects",
    "rules"
  ],
  "title": "ConfigGetResult",
  "type": "object"
}
