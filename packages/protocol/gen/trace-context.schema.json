{
  "$defs": {
    "TraceContextItem": {
      "additionalProperties": false,
      "description": "One tool or one prompt section, with its share of the tokens.",
      "properties": {
        "group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "tokens": {
          "minimum": 0,
          "title": "Tokens",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "tokens"
      ],
      "title": "TraceContextItem",
      "type": "object"
    },
    "TraceContextPart": {
      "additionalProperties": false,
      "description": "One kind of content in the context.",
      "properties": {
        "chars": {
          "minimum": 0,
          "title": "Chars",
          "type": "integer"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/TraceContextItem"
          },
          "title": "Items",
          "type": "array"
        },
        "key": {
          "enum": [
            "system",
            "tools",
            "user",
            "assistant",
            "tool_results"
          ],
          "title": "Key",
          "type": "string"
        },
        "tokens": {
          "minimum": 0,
          "title": "Tokens",
          "type": "integer"
        }
      },
      "required": [
        "key",
        "tokens",
        "chars"
      ],
      "title": "TraceContextPart",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "What filled one model call's context, and how big the window was.\n\n``parts`` always has the five keys, in order. They add up to ``used``\nwhen it is known. The split between them is an estimate (about four\ncharacters a token, scaled to ``used``), so ``estimated`` is always true.\nThe ``prompt_cut`` fields are those of the model span.",
  "properties": {
    "dropped_message_ids": {
      "items": {
        "type": "string"
      },
      "title": "Dropped Message Ids",
      "type": "array"
    },
    "dropped_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dropped Tokens"
    },
    "estimated": {
      "default": true,
      "title": "Estimated",
      "type": "boolean"
    },
    "num_ctx": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Num Ctx"
    },
    "parts": {
      "items": {
        "$ref": "#/$defs/TraceContextPart"
      },
      "title": "Parts",
      "type": "array"
    },
    "prompt_cut": {
      "anyOf": [
        {
          "enum": [
            "no",
            "yes",
            "likely"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Cut"
    },
    "prompt_cut_kind": {
      "anyOf": [
        {
          "enum": [
            "older_messages",
            "middle"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Cut Kind"
    },
    "used": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Used"
    },
    "window": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Window"
    },
    "window_estimated": {
      "default": false,
      "title": "Window Estimated",
      "type": "boolean"
    }
  },
  "required": [
    "parts"
  ],
  "title": "TraceContext",
  "type": "object"
}
