{
  "$defs": {
    "AgentLimits": {
      "additionalProperties": false,
      "description": "What bounds one helper of this type. ``None`` means the file sets no limit of that kind.\n\n``max_seconds`` is working time: it does not count the time spent waiting for\nyou, for a slot or for a provider. ``answer_chars`` cuts the helper's final answer.",
      "properties": {
        "answer_chars": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer Chars"
        },
        "max_calls": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Calls"
        },
        "max_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Usd"
        },
        "max_seconds": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Seconds"
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        }
      },
      "title": "AgentLimits",
      "type": "object"
    },
    "WishResolution": {
      "additionalProperties": false,
      "description": "What a type's wish becomes in this setup.\n\n``model`` is the model the wish picks now and ``tier`` its tier. ``reason`` is one plain\nline on why, at most 200 characters. ``fresh_window`` is true when the helper starts\nwith an empty context window on that model. Every field may be left out.",
      "properties": {
        "fresh_window": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fresh Window"
        },
        "model": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "tier": {
          "anyOf": [
            {
              "enum": [
                "local",
                "budget",
                "frontier"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tier"
        }
      },
      "title": "WishResolution",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The agent type after the change.",
  "properties": {
    "asks": {
      "default": false,
      "title": "Asks",
      "type": "boolean"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    },
    "finished": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished"
    },
    "limits": {
      "$ref": "#/$defs/AgentLimits"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "origin": {
      "enum": [
        "bundled",
        "user",
        "project"
      ],
      "title": "Origin",
      "type": "string"
    },
    "resolves_to": {
      "anyOf": [
        {
          "$ref": "#/$defs/WishResolution"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "shadowed": {
      "items": {
        "enum": [
          "bundled",
          "user",
          "project"
        ],
        "type": "string"
      },
      "title": "Shadowed",
      "type": "array"
    },
    "tools": {
      "items": {
        "type": "string"
      },
      "title": "Tools",
      "type": "array"
    },
    "trusted": {
      "default": true,
      "title": "Trusted",
      "type": "boolean"
    },
    "used": {
      "default": 0,
      "minimum": 0,
      "title": "Used",
      "type": "integer"
    },
    "wish": {
      "minLength": 1,
      "title": "Wish",
      "type": "string"
    }
  },
  "required": [
    "name",
    "description",
    "origin",
    "wish"
  ],
  "title": "AgentsSetWishResult",
  "type": "object"
}
