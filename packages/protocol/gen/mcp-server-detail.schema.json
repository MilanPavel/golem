{
  "$defs": {
    "McpOAuthConfig": {
      "additionalProperties": false,
      "description": "``oauth`` in an HTTP server's table: a client id for a server with no registration.",
      "properties": {
        "client_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Id"
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        }
      },
      "title": "McpOAuthConfig",
      "type": "object"
    },
    "McpSecretInfo": {
      "additionalProperties": false,
      "description": "A secret a server names, ``ref`` as ``mcp/<name>``, and whether the store has it.\n\nThe value is never sent.",
      "properties": {
        "ref": {
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        },
        "stored": {
          "title": "Stored",
          "type": "boolean"
        }
      },
      "required": [
        "ref",
        "stored"
      ],
      "title": "McpSecretInfo",
      "type": "object"
    },
    "McpServer": {
      "additionalProperties": false,
      "description": "One MCP server from ``[mcp.<name>]``.\n\n``command`` is the command line golem runs, or the URL it reaches.\n``project`` is the folder whose ``.golem/config.toml`` names the server,\nor null for the user's own. ``on_demand`` servers are ``idle`` until a\nsession turns one on, and ``enabled`` says whether the asking session\nhas it, when ``mcp.list`` named one. ``tools`` are the names the model\nsees, ``mcp__<server>__<tool>``, while it is ``running``, and\n``schema_tokens`` roughly what their schemas cost in each prompt.\n``error`` says why it is ``failed``, and ``retry_seconds`` when golem\ntries again. ``config`` is the file that names the server. ``tools_hidden``\ncounts the tools its ``tools`` filter keeps from the model, and\n``approval`` is ``\"allow\"`` when its calls run without asking, and\n``\"read-only\"`` when only the tools it marks read-only do.",
      "properties": {
        "approval": {
          "default": "ask",
          "enum": [
            "ask",
            "read-only",
            "allow"
          ],
          "title": "Approval",
          "type": "string"
        },
        "command": {
          "title": "Command",
          "type": "string"
        },
        "config": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config"
        },
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enabled"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "on_demand": {
          "default": false,
          "title": "On Demand",
          "type": "boolean"
        },
        "project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        },
        "retry_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry Seconds"
        },
        "schema_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Tokens"
        },
        "state": {
          "enum": [
            "idle",
            "starting",
            "running",
            "failed",
            "disabled",
            "needs_auth"
          ],
          "title": "State",
          "type": "string"
        },
        "tools": {
          "items": {
            "type": "string"
          },
          "title": "Tools",
          "type": "array"
        },
        "tools_hidden": {
          "default": 0,
          "minimum": 0,
          "title": "Tools Hidden",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "state",
        "command"
      ],
      "title": "McpServer",
      "type": "object"
    },
    "McpServerConfig": {
      "additionalProperties": false,
      "description": "Every field of ``[mcp.<name>]``, as it goes over the wire.\n\nThe daemon's settings model has the same fields, and a test keeps the two\nequal. A value in ``env`` or ``headers`` names a secret as\n``keychain:mcp/<name>``, never the secret itself.",
      "properties": {
        "approval": {
          "default": "ask",
          "enum": [
            "ask",
            "read-only",
            "allow"
          ],
          "title": "Approval",
          "type": "string"
        },
        "args": {
          "items": {
            "type": "string"
          },
          "title": "Args",
          "type": "array"
        },
        "command": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "cwd": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cwd"
        },
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "const": "on_demand",
              "type": "string"
            }
          ],
          "default": true,
          "title": "Enabled"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Env",
          "type": "object"
        },
        "env_passthrough": {
          "items": {
            "type": "string"
          },
          "title": "Env Passthrough",
          "type": "array"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Headers",
          "type": "object"
        },
        "oauth": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpOAuthConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "timeout_seconds": {
          "default": 120,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "tools": {
          "$ref": "#/$defs/McpToolFilterConfig"
        },
        "url": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "title": "McpServerConfig",
      "type": "object"
    },
    "McpToolFilterConfig": {
      "additionalProperties": false,
      "description": "``tools`` of ``[mcp.<name>]``: ``fnmatch`` patterns on the server's own tool names.\n\nAn empty ``include`` means every tool, and ``exclude`` wins.",
      "properties": {
        "exclude": {
          "items": {
            "type": "string"
          },
          "title": "Exclude",
          "type": "array"
        },
        "include": {
          "items": {
            "type": "string"
          },
          "title": "Include",
          "type": "array"
        }
      },
      "title": "McpToolFilterConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``mcp.get``. One server's status, its whole config, and where it is written.\n\n``scope`` is ``\"project\"`` for a server in a project's ``.golem/config.toml``,\nand ``path`` is the file that names it.",
  "properties": {
    "config": {
      "$ref": "#/$defs/McpServerConfig"
    },
    "path": {
      "title": "Path",
      "type": "string"
    },
    "scope": {
      "enum": [
        "user",
        "project"
      ],
      "title": "Scope",
      "type": "string"
    },
    "secrets": {
      "items": {
        "$ref": "#/$defs/McpSecretInfo"
      },
      "title": "Secrets",
      "type": "array"
    },
    "server": {
      "$ref": "#/$defs/McpServer"
    }
  },
  "required": [
    "server",
    "config",
    "scope",
    "path",
    "secrets"
  ],
  "title": "McpServerDetail",
  "type": "object"
}
