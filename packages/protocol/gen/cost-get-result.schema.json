{
  "$defs": {
    "CostDayRow": {
      "additionalProperties": false,
      "description": "One local day. ``local_tokens`` are input plus output of ``local`` calls, and\n``paid_tokens`` those of every other call.",
      "properties": {
        "cost_usd": {
          "minimum": 0,
          "title": "Cost Usd",
          "type": "number"
        },
        "day": {
          "maxLength": 10,
          "minLength": 10,
          "title": "Day",
          "type": "string"
        },
        "local_tokens": {
          "minimum": 0,
          "title": "Local Tokens",
          "type": "integer"
        },
        "paid_tokens": {
          "minimum": 0,
          "title": "Paid Tokens",
          "type": "integer"
        }
      },
      "required": [
        "day",
        "local_tokens",
        "paid_tokens",
        "cost_usd"
      ],
      "title": "CostDayRow",
      "type": "object"
    },
    "CostModelRow": {
      "additionalProperties": false,
      "description": "One model's calls over the last 7 days.\n\n``provider``, ``model`` and ``tier`` are null for a call whose model was not known.",
      "properties": {
        "calls": {
          "minimum": 0,
          "title": "Calls",
          "type": "integer"
        },
        "cost_usd": {
          "minimum": 0,
          "title": "Cost Usd",
          "type": "number"
        },
        "input": {
          "minimum": 0,
          "title": "Input",
          "type": "integer"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "output": {
          "minimum": 0,
          "title": "Output",
          "type": "integer"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "tier": {
          "anyOf": [
            {
              "enum": [
                "local",
                "budget",
                "frontier"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tier"
        }
      },
      "required": [
        "calls",
        "input",
        "output",
        "cost_usd"
      ],
      "title": "CostModelRow",
      "type": "object"
    },
    "CostRoleRow": {
      "additionalProperties": false,
      "description": "One job's calls over the last 7 days: ``chat``, ``explore`` (a helper), ``title``...",
      "properties": {
        "calls": {
          "minimum": 0,
          "title": "Calls",
          "type": "integer"
        },
        "cost_usd": {
          "minimum": 0,
          "title": "Cost Usd",
          "type": "number"
        },
        "input": {
          "minimum": 0,
          "title": "Input",
          "type": "integer"
        },
        "output": {
          "minimum": 0,
          "title": "Output",
          "type": "integer"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "calls",
        "input",
        "output",
        "cost_usd"
      ],
      "title": "CostRoleRow",
      "type": "object"
    },
    "CostTotals": {
      "additionalProperties": false,
      "description": "Calls, tokens and money over one span.\n\n``cost_usd`` is what paid calls cost, at the price golem knew then. ``saved_usd`` is what\nthe tokens of ``local`` calls would have cost at the reference model's price, and 0 when\nthere is no reference. Money is a float on purpose: sub-cent amounts. Round to show it.",
      "properties": {
        "calls": {
          "minimum": 0,
          "title": "Calls",
          "type": "integer"
        },
        "cost_usd": {
          "minimum": 0,
          "title": "Cost Usd",
          "type": "number"
        },
        "input": {
          "minimum": 0,
          "title": "Input",
          "type": "integer"
        },
        "output": {
          "minimum": 0,
          "title": "Output",
          "type": "integer"
        },
        "saved_usd": {
          "minimum": 0,
          "title": "Saved Usd",
          "type": "number"
        }
      },
      "required": [
        "calls",
        "input",
        "output",
        "cost_usd",
        "saved_usd"
      ],
      "title": "CostTotals",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``week`` is the last 7 local days, today included. ``session`` is set when the\nrequest named a session. ``by_model`` is sorted by cost, highest first, and ``by_day``\nhas one row for each of the 7 days, oldest first. ``by_role`` is sorted by cost, highest\nfirst. ``saved_reference`` is the\n``provider/model`` ref whose prices ``saved_usd`` uses, or null when there is none.",
  "properties": {
    "by_day": {
      "items": {
        "$ref": "#/$defs/CostDayRow"
      },
      "title": "By Day",
      "type": "array"
    },
    "by_model": {
      "items": {
        "$ref": "#/$defs/CostModelRow"
      },
      "title": "By Model",
      "type": "array"
    },
    "by_role": {
      "items": {
        "$ref": "#/$defs/CostRoleRow"
      },
      "title": "By Role",
      "type": "array"
    },
    "saved_reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Saved Reference"
    },
    "session": {
      "anyOf": [
        {
          "$ref": "#/$defs/CostTotals"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "today": {
      "$ref": "#/$defs/CostTotals"
    },
    "week": {
      "$ref": "#/$defs/CostTotals"
    }
  },
  "required": [
    "today",
    "week"
  ],
  "title": "CostGetResult",
  "type": "object"
}
