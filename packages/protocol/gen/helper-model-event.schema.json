{
  "$defs": {
    "HelperModelData": {
      "additionalProperties": false,
      "description": "The model a helper runs on changed after ``helper.started``.\n\nThis is on the lead's log, with the same ``call_id``, ``index`` and ``helper_id`` as\n``helper.started``. It is written when the paid question is answered with a no: the\nhelper then runs on a local model. ``model`` is the model it runs on and ``pick_reason``\nsays in plain words why. A yes writes nothing.",
      "properties": {
        "call_id": {
          "minLength": 1,
          "title": "Call Id",
          "type": "string"
        },
        "helper_id": {
          "minLength": 1,
          "title": "Helper Id",
          "type": "string"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "pick_reason": {
          "title": "Pick Reason",
          "type": "string"
        }
      },
      "required": [
        "call_id",
        "index",
        "helper_id",
        "model",
        "pick_reason"
      ],
      "title": "HelperModelData",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The model of a helper changed after it started. A summary on the lead's log.",
  "properties": {
    "data": {
      "$ref": "#/$defs/HelperModelData"
    },
    "run_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "seq": {
      "minimum": 1,
      "title": "Seq",
      "type": "integer"
    },
    "session_id": {
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "ts": {
      "minLength": 1,
      "title": "Ts",
      "type": "string"
    },
    "type": {
      "const": "helper.model",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "seq",
    "session_id",
    "ts",
    "type",
    "data"
  ],
  "title": "HelperModelEvent",
  "type": "object"
}
