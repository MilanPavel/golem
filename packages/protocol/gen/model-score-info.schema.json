{
  "additionalProperties": false,
  "description": "How a model did on this Mac, from real use.\n\n``tool_score`` is the share of its last 200 tool calls that were valid, or null with\nfewer than 20. ``calls`` is its model calls, ``runs`` the runs that used it, ``stepped_up``\nthe runs that left it for a stronger model, and ``retried`` the answers the user asked a\nstronger model to redo.",
  "properties": {
    "calls": {
      "minimum": 0,
      "title": "Calls",
      "type": "integer"
    },
    "retried": {
      "minimum": 0,
      "title": "Retried",
      "type": "integer"
    },
    "runs": {
      "minimum": 0,
      "title": "Runs",
      "type": "integer"
    },
    "stepped_up": {
      "minimum": 0,
      "title": "Stepped Up",
      "type": "integer"
    },
    "tool_calls": {
      "minimum": 0,
      "title": "Tool Calls",
      "type": "integer"
    },
    "tool_score": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Score"
    }
  },
  "required": [
    "calls",
    "runs",
    "stepped_up",
    "retried",
    "tool_calls"
  ],
  "title": "ModelScoreInfo",
  "type": "object"
}
