      "properties": {
        "cwd": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cwd"
        },
        "title": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "title": "SessionUpdatedData",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The session got a title. ``run_id`` is null: no run owns the change.",
  "properties": {
    "data": {
