{
  "$defs": {
    "DataSource": {
      "additionalProperties": false,
      "description": "One data source. ``location`` is for display and never holds a password.",
      "properties": {
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "in_keychain": {
          "default": false,
          "title": "In Keychain",
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "builtin",
            "files",
            "sqlite",
            "duckdb",
            "postgres",
            "mysql",
            "url"
          ],
          "title": "Kind",
          "type": "string"
        },
        "location": {
          "title": "Location",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "needs_extension": {
          "anyOf": [
            {
              "enum": [
                "excel",
                "sqlite",
                "postgres",
                "mysql"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Needs Extension"
        },
        "notes_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes Path"
        },
        "privacy": {
          "enum": [
            "open",
            "local",
            "schema"
          ],
          "title": "Privacy",
          "type": "string"
        },
        "privacy_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Privacy Reason"
        },
        "project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        },
        "rows": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rows"
        },
        "scope": {
          "enum": [
            "builtin",
            "user",
            "project"
          ],
          "title": "Scope",
          "type": "string"
        },
        "status": {
          "enum": [
            "ready",
            "reading",
            "untrusted",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "tables": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tables"
        },
        "timeout_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout S"
        },
        "warning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Warning"
        },
        "watch": {
          "default": false,
          "title": "Watch",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "kind",
        "scope",
        "location",
        "privacy",
        "status"
      ],
      "title": "DataSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The sources.",
  "properties": {
    "sources": {
      "items": {
        "$ref": "#/$defs/DataSource"
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "sources"
  ],
  "title": "DataListResult",
  "type": "object"
}
