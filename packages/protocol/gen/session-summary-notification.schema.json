{
  "$defs": {
    "PendingItem": {
      "additionalProperties": false,
      "description": "What a waiting session waits for, in a form a client can list without opening it.\n\n``kind`` is ``approval`` for a tool call that needs a yes, and ``consent`` for the paid\nstep-up question. ``since`` is the ``ts`` of the event that asked\n(``approval.needed`` or ``route.consent.needed``). For an approval, ``call_id``, ``name``,\n``subject`` and ``source`` are those of the ``approval.needed`` event, and ``added`` and\n``removed`` count the lines its diff adds and removes (null when the call has no diff).\nFor a consent, ``alternatives`` is the number of answers the user may give. The full diff\nstays in the session's events: a summary goes to every watcher on every event, so it\ncarries counts only. An older daemon leaves ``pending`` out of the summary.",
      "properties": {
        "added": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Added"
        },
        "alternatives": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alternatives"
        },
        "call_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Call Id"
        },
        "kind": {
          "enum": [
            "approval",
            "consent"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "removed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Removed"
        },
        "since": {
          "minLength": 1,
          "title": "Since",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        }
      },
      "required": [
        "kind",
        "since"
      ],
      "title": "PendingItem",
      "type": "object"
    },
    "SessionSummary": {
      "additionalProperties": false,
      "description": "One session as ``session.list`` reports it.\n\n``status`` is ``running`` while a run is open, ``waiting`` while a run\nwaits for a tool approval, and ``closed`` after ``session.close``. ``last_seq`` is the newest\nstored event, so a client can tell what it has not seen, and which of\ntwo summaries of one session is newer. ``cwd`` is the session's project\nfolder, null for a session that has not been given one. ``forked_from`` is\nthe id of the session this one was forked from, null for a session that is\nnot a fork. An older daemon leaves it out. ``origin`` is who started the\nsession: ``user``, ``cli``, ``routine:<name>``. A session never changes it.\n``route`` is the session's route mode. An older daemon leaves it out.\n``plan_first`` is true while the session is in plan first (``session.set_plan``).\n``local_only`` is true while the session's folder stays on this Mac: only a local model\nreads its chat. It follows the settings of the moment, so it can change without an event.\nAn older daemon leaves it out.\n``pending`` says what a ``waiting`` session waits for, null otherwise. An older daemon\nleaves it out.\n``parent_session_id`` and ``agent`` are set on a helper session: the id of the\nsession. An older daemon leaves them out.\n``wait_reason`` and ``wait_line`` say that the running run's model call waits in line:\nthe reason (``slot``, ``provider`` or ``load``) and the plain name of the model or provider.\nNull when no call waits, and for the waits the status already shows. An older daemon\nleaves them out.",
      "properties": {
        "agent": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent"
        },
        "created_at": {
          "minLength": 1,
          "title": "Created At",
          "type": "string"
        },
        "cwd": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cwd"
        },
        "forked_from": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Forked From"
        },
        "last_seq": {
          "minimum": 0,
          "title": "Last Seq",
          "type": "integer"
        },
        "local_only": {
          "default": false,
          "title": "Local Only",
          "type": "boolean"
        },
        "model_profile": {
          "minLength": 1,
          "title": "Model Profile",
          "type": "string"
        },
        "origin": {
          "default": "user",
          "minLength": 1,
          "title": "Origin",
          "type": "string"
        },
        "parent_session_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Session Id"
        },
        "pending": {
          "anyOf": [
            {
              "$ref": "#/$defs/PendingItem"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "plan_first": {
          "default": false,
          "title": "Plan First",
          "type": "boolean"
        },
        "route": {
          "default": "pinned",
          "enum": [
            "pinned",
            "local",
            "auto"
          ],
          "title": "Route",
          "type": "string"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "idle",
            "running",
            "waiting",
            "closed"
          ],
          "title": "Status",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "updated_at": {
          "minLength": 1,
          "title": "Updated At",
          "type": "string"
        },
        "wait_line": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wait Line"
        },
        "wait_reason": {
          "anyOf": [
            {
              "enum": [
                "slot",
                "load",
                "provider",
                "team",
                "budget",
                "you",
                "stalled"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wait Reason"
        }
      },
      "required": [
        "session_id",
        "model_profile",
        "status",
        "created_at",
        "updated_at",
        "last_seq"
      ],
      "title": "SessionSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Server → watcher: a session's summary after it changed.\n\nSent to connections that called ``session.list`` with ``watch``. It is not\npart of any session's event stream and has no ``seq`` of its own.",
  "properties": {
    "jsonrpc": {
      "const": "2.0",
      "default": "2.0",
      "title": "Jsonrpc",
      "type": "string"
    },
    "method": {
      "const": "session.summary",
      "default": "session.summary",
      "title": "Method",
      "type": "string"
    },
    "params": {
      "$ref": "#/$defs/SessionSummary"
    }
  },
  "required": [
    "params"
  ],
  "title": "SessionSummaryNotification",
  "type": "object"
}
