{
  "$defs": {
    "McpToolInfo": {
      "additionalProperties": false,
      "description": "One of a server's tools: the name the model sees, and what it says it does.\n\nA ``hidden`` tool is one the server's ``tools`` filter keeps from the model.\n``schema_tokens`` roughly what its schema costs in each prompt.\n``input_schema`` is the JSON Schema of its arguments, for a form that tries it.\n``read_only`` is the server's own ``readOnlyHint``: its word, not golem's check.",
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "hidden": {
          "default": false,
          "title": "Hidden",
          "type": "boolean"
        },
        "input_schema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Schema"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "read_only": {
          "default": false,
          "title": "Read Only",
          "type": "boolean"
        },
        "schema_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Schema Tokens",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "McpToolInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The running server's tools, in its order. Empty while it is not running.",
  "properties": {
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/McpToolInfo"
      },
      "title": "Tools",
      "type": "array"
    }
  },
  "required": [
    "name",
    "tools"
  ],
  "title": "McpToolsResult",
  "type": "object"
}
