        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Name"
    },
    "model_profile": {
      "minLength": 1,
      "title": "Model Profile",
      "type": "string"
    },
    "model_provider": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Provider"
    },
    "reason": {
      "const": "user",
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
