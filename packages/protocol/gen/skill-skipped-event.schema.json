{
  "$defs": {
    "SkillSkippedData": {
      "additionalProperties": false,
      "description": "A pinned skill was left out of a model call. It stays pinned.\n\n``reason`` is ``missing`` when the session finds no skill of that name,\n``disabled`` when ``[skills]`` turns it off, and ``broken`` when its\n``SKILL.md`` cannot be read or is not valid. ``message`` says it for a\nperson.",
      "properties": {
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "reason": {
          "enum": [
            "missing",
            "disabled",
            "broken"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "name",
        "reason",
        "message"
      ],
      "title": "SkillSkippedData",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A pinned skill was left out of the run's model calls.\n\nLogged once when it becomes unusable, not for every call.",
  "properties": {
    "data": {
      "$ref": "#/$defs/SkillSkippedData"
    },
    "run_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "seq": {
      "minimum": 1,
      "title": "Seq",
      "type": "integer"
    },
    "session_id": {
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "ts": {
      "minLength": 1,
      "title": "Ts",
      "type": "string"
    },
    "type": {
      "const": "skill.skipped",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "seq",
    "session_id",
    "ts",
    "type",
    "data"
  ],
  "title": "SkillSkippedEvent",
  "type": "object"
}
