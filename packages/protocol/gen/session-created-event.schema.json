{
  "$defs": {
    "ForkedFrom": {
      "additionalProperties": false,
      "description": "The session and message a fork was copied from.",
      "properties": {
        "message_id": {
          "minLength": 1,
          "title": "Message Id",
          "type": "string"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "message_id"
      ],
      "title": "ForkedFrom",
      "type": "object"
    },
    "SessionCreatedData": {
      "additionalProperties": false,
      "description": "Profile stored for a new session.\n\n``model_profile`` is a profile name or a ``provider/model`` ref.\n``model_provider`` and ``model_name`` are set when the daemon can resolve\nit, and null otherwise. ``forked_from`` is set on a session made by\n``session.fork``.",
      "properties": {
        "forked_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/ForkedFrom"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Name"
        },
        "model_profile": {
          "minLength": 1,
          "title": "Model Profile",
          "type": "string"
        },
        "model_provider": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Provider"
        }
      },
      "required": [
        "model_profile"
      ],
      "title": "SessionCreatedData",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A session exists. ``run_id`` is null because no run has started.",
  "properties": {
    "data": {
      "$ref": "#/$defs/SessionCreatedData"
    },
    "run_id": {
      "title": "Run Id",
      "type": "null"
    },
    "seq": {
      "minimum": 1,
      "title": "Seq",
      "type": "integer"
    },
    "session_id": {
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "ts": {
      "minLength": 1,
      "title": "Ts",
      "type": "string"
    },
    "type": {
      "const": "session.created",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "seq",
    "session_id",
    "run_id",
    "ts",
    "type",
    "data"
  ],
  "title": "SessionCreatedEvent",
  "type": "object"
}
