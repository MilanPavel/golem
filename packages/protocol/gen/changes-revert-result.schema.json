    "conflicts": {
      "items": {
        "$ref": "#/$defs/RevertConflict"
      },
      "title": "Conflicts",
      "type": "array"
    },
    "reverted": {
      "items": {
        "type": "string"
      },
      "title": "Reverted",
      "type": "array"
    }
  },
  "required": [
    "reverted",
    "conflicts"
  ],
  "title": "ChangesRevertResult",
  "type": "object"
