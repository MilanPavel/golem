{
  "$defs": {
    "ToolStartedData": {
      "additionalProperties": false,
      "description": "A requested tool call is running.\n\n``parent_call_id`` is set on an event of a child run: the id of the ``delegate`` call\nthat started it. The event is in the parent's run, and a client that does not know\nchild runs ignores it. None for the run's own events.",
      "properties": {
        "call_id": {
          "minLength": 1,
          "title": "Call Id",
          "type": "string"
        },
        "parent_call_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Call Id"
        }
      },
      "required": [
        "call_id"
      ],
      "title": "ToolStartedData",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The tool call is running.",
  "properties": {
    "data": {
      "$ref": "#/$defs/ToolStartedData"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "seq": {
      "minimum": 1,
      "title": "Seq",
      "type": "integer"
    },
    "session_id": {
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "ts": {
      "minLength": 1,
      "title": "Ts",
      "type": "string"
    },
    "type": {
      "const": "tool.started",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "seq",
    "session_id",
    "run_id",
    "ts",
    "type",
    "data"
  ],
  "title": "ToolStartedEvent",
  "type": "object"
}
