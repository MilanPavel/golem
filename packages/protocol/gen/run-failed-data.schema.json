{
  "additionalProperties": false,
  "description": "Why a run stopped. No traceback.\n\n``code`` names a failure a client can act on. ``model_unreachable``: the\nmodel's server did not answer. ``not_installed``: the model needs a local\nserver that is not installed, such as Ollama. ``provider`` is the provider\nwhose server it was, and ``hint`` says how to fix it, such as\n``run ollama serve``.",
  "properties": {
    "code": {
      "anyOf": [
        {
          "enum": [
            "model_unreachable",
            "not_installed"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code"
    },
    "hint": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hint"
    },
    "message": {
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "provider": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider"
    }
  },
  "required": [
    "message"
  ],
  "title": "RunFailedData",
  "type": "object"
}
