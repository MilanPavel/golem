{
  "additionalProperties": false,
  "description": "One tool rule, in the order rules are checked.\n\n``source`` names the file and the rule's number in it, or ``built-in\ndefault``. ``ignored`` says why a listed rule never matches. ``file`` and\n``index`` are what ``policy.update`` and ``policy.remove`` take.",
  "properties": {
    "action": {
      "enum": [
        "allow",
        "ask",
        "deny"
      ],
      "title": "Action",
      "type": "string"
    },
    "file": {
      "default": "default",
      "enum": [
        "user",
        "project",
        "default"
      ],
      "title": "File",
      "type": "string"
    },
    "ignored": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ignored"
    },
    "index": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Index"
    },
    "match": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Match"
    },
    "path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Path"
    },
    "source": {
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "tool": {
      "minLength": 1,
      "title": "Tool",
      "type": "string"
    }
  },
  "required": [
    "tool",
    "action",
    "source"
  ],
  "title": "ConfigRule",
  "type": "object"
}
