{
  "$defs": {
    "McpImportFailure": {
      "additionalProperties": false,
      "description": "A pick that was not added, and why.",
      "properties": {
        "error": {
          "title": "Error",
          "type": "string"
        },
        "key": {
          "title": "Key",
          "type": "string"
        }
      },
      "required": [
        "key",
        "error"
      ],
      "title": "McpImportFailure",
      "type": "object"
    },
    "McpServer": {
      "additionalProperties": false,
      "description": "One MCP server from ``[mcp.<name>]``.\n\n``command`` is the command line golem runs, or the URL it reaches.\n``project`` is the folder whose ``.golem/config.toml`` names the server,\nor null for the user's own. ``on_demand`` servers are ``idle`` until a\nsession turns one on, and ``enabled`` says whether the asking session\nhas it, when ``mcp.list`` named one. ``tools`` are the names the model\nsees, ``mcp__<server>__<tool>``, while it is ``running``, and\n``schema_tokens`` roughly what their schemas cost in each prompt.\n``error`` says why it is ``failed``, and ``retry_seconds`` when golem\ntries again. ``config`` is the file that names the server. ``tools_hidden``\ncounts the tools its ``tools`` filter keeps from the model, and\n``approval`` is ``\"allow\"`` when its calls run without asking.",
      "properties": {
        "approval": {
          "default": "ask",
          "enum": [
            "ask",
            "allow"
          ],
          "title": "Approval",
          "type": "string"
        },
        "command": {
          "title": "Command",
          "type": "string"
        },
        "config": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config"
        },
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enabled"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "on_demand": {
          "default": false,
          "title": "On Demand",
          "type": "boolean"
        },
        "project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        },
        "retry_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry Seconds"
        },
        "schema_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Tokens"
        },
        "state": {
          "enum": [
            "idle",
            "starting",
            "running",
            "failed",
            "disabled"
          ],
          "title": "State",
          "type": "string"
        },
        "tools": {
          "items": {
            "type": "string"
          },
          "title": "Tools",
          "type": "array"
        },
        "tools_hidden": {
          "default": 0,
          "minimum": 0,
          "title": "Tools Hidden",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "state",
        "command"
      ],
      "title": "McpServer",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The servers added, and the picks that failed.",
  "properties": {
    "added": {
      "items": {
        "$ref": "#/$defs/McpServer"
      },
      "title": "Added",
      "type": "array"
    },
    "failed": {
      "items": {
        "$ref": "#/$defs/McpImportFailure"
      },
      "title": "Failed",
      "type": "array"
    }
  },
  "required": [
    "added"
  ],
  "title": "McpImportApplyResult",
  "type": "object"
}
