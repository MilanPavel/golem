        "files": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Files",
          "type": "array"
        },
        "text": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "PlanStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
