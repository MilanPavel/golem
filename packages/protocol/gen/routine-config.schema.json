{
  "$defs": {
    "RoutineQueryConfig": {
      "additionalProperties": false,
      "description": "``query = { source, saved }``: the saved query of a data source that a routine runs.",
      "properties": {
        "saved": {
          "minLength": 1,
          "title": "Saved",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "saved"
      ],
      "title": "RoutineQueryConfig",
      "type": "object"
    },
    "RoutineWatchConfig": {
      "additionalProperties": false,
      "description": "``on = { watch, glob }``: a new file in ``watch`` that matches ``glob``.",
      "properties": {
        "glob": {
          "default": "*",
          "minLength": 1,
          "title": "Glob",
          "type": "string"
        },
        "watch": {
          "minLength": 1,
          "title": "Watch",
          "type": "string"
        }
      },
      "required": [
        "watch"
      ],
      "title": "RoutineWatchConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One ``[[routine]]`` as written. The daemon checks it when it loads.\n\nExactly one of ``schedule`` and ``on`` is set, and exactly one of ``prompt``,\n``workflow`` and ``query``. ``query`` runs a saved query of a data source with no model and\nno session; ``post`` says when its result goes to the Inbox: ``always`` (the default) or\n``rows`` (only when the query finds rows), and it is only for a query. ``workflow`` names\na workflow to start, with ``inputs`` (a watch routine also passes ``path``); it takes no\n``folder``, ``model`` or ``mcp``. ``schedule`` is cron, or\n``every 15m``, ``every 1h``, ``daily 08:30``, ``weekdays 08:30``, ``weekly mon 06:00``.\n``missed`` is what happens to a firing that came due while golem could not\nrun it: ``skip`` drops it, ``run_once`` fires it once, late.\n``notify_finished`` and ``notify_failed`` override the notification settings\nfor this routine, and null keeps them.",
  "properties": {
    "enabled": {
      "default": true,
      "title": "Enabled",
      "type": "boolean"
    },
    "folder": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Folder"
    },
    "inputs": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "title": "Inputs",
      "type": "object"
    },
    "mcp": {
      "items": {
        "type": "string"
      },
      "title": "Mcp",
      "type": "array"
    },
    "missed": {
      "default": "skip",
      "enum": [
        "skip",
        "run_once"
      ],
      "title": "Missed",
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "notify_failed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notify Failed"
    },
    "notify_finished": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notify Finished"
    },
    "on": {
      "anyOf": [
        {
          "$ref": "#/$defs/RoutineWatchConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "post": {
      "anyOf": [
        {
          "enum": [
            "always",
            "rows"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Post"
    },
    "prompt": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt"
    },
    "query": {
      "anyOf": [
        {
          "$ref": "#/$defs/RoutineQueryConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schedule": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Schedule"
    },
    "workflow": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workflow"
    }
  },
  "required": [
    "name"
  ],
  "title": "RoutineConfig",
  "type": "object"
}
