{
  "$defs": {
    "WorkflowRunInfo": {
      "additionalProperties": false,
      "description": "One run of a workflow, from its ``workflow_runs`` row.\n\nThe times are ISO 8601 with an offset. ``session_id`` is the run's headless session.\n``error`` says why a ``failed`` run failed.",
      "properties": {
        "ended_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ended At"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "session_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "waiting",
            "done",
            "failed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "trigger": {
          "enum": [
            "manual",
            "schedule",
            "on_file"
          ],
          "title": "Trigger",
          "type": "string"
        },
        "workflow_id": {
          "minLength": 1,
          "title": "Workflow Id",
          "type": "string"
        },
        "workflow_run_id": {
          "minLength": 1,
          "title": "Workflow Run Id",
          "type": "string"
        }
      },
      "required": [
        "workflow_run_id",
        "workflow_id",
        "name",
        "status",
        "trigger"
      ],
      "title": "WorkflowRunInfo",
      "type": "object"
    },
    "WorkflowStepInfo": {
      "additionalProperties": false,
      "description": "One step of a run, from its ``workflow_steps`` row.\n\n``key`` is the step key the engine journals by, ``group`` the key of the group it runs in.\n``attempts`` counts starts. ``child_session_id`` is the helper session of an ``agent`` step.\n``in_doubt`` is a step that may have had its effect before the daemon stopped.",
      "properties": {
        "attempts": {
          "default": 0,
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "child_session_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Child Session Id"
        },
        "ended_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ended At"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "step",
            "agent",
            "review",
            "notify",
            "llm",
            "tool",
            "skill"
          ],
          "title": "Kind",
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "waiting",
            "done",
            "failed",
            "skipped",
            "in_doubt"
          ],
          "title": "Status",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "key",
        "kind",
        "title",
        "status"
      ],
      "title": "WorkflowStepInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The run and its steps, in the order they started.",
  "properties": {
    "run": {
      "$ref": "#/$defs/WorkflowRunInfo"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/WorkflowStepInfo"
      },
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "run"
  ],
  "title": "WorkflowStatusResult",
  "type": "object"
}
