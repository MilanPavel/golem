{
  "additionalProperties": false,
  "description": "Where the user is in setting up a model, for a first-run screen.\n\n``keys`` are the providers with a key, from the environment or the\nKeychain. ``default_status`` is the default model's status, ``unknown``\nwhen it names a model golem does not list, and null when no default is\nchosen.",
  "properties": {
    "default_status": {
      "anyOf": [
        {
          "enum": [
            "ready",
            "needs_key",
            "not_installed",
            "server_down",
            "pulling",
            "unknown"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Default Status"
    },
    "keys": {
      "items": {
        "type": "string"
      },
      "title": "Keys",
      "type": "array"
    },
    "ollama_installed": {
      "title": "Ollama Installed",
      "type": "boolean"
    },
    "ollama_running": {
      "title": "Ollama Running",
      "type": "boolean"
    }
  },
  "required": [
    "ollama_installed",
    "ollama_running"
  ],
  "title": "ModelSetup",
  "type": "object"
}
