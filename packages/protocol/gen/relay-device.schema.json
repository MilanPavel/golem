{
  "additionalProperties": false,
  "description": "A paired device that is not revoked: its id and its 65-byte public key.",
  "properties": {
    "id": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Id",
      "type": "string"
    },
    "key": {
      "pattern": "^[A-Za-z0-9_-]{87}$",
      "title": "Key",
      "type": "string"
    }
  },
  "required": [
    "id",
    "key"
  ],
  "title": "RelayDevice",
  "type": "object"
}
