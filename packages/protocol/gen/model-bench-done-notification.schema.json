{
  "$defs": {
    "ModelBenchDone": {
      "additionalProperties": false,
      "description": "A run ended. ``error`` says why when ``ok`` is false, and then ``rows`` may be short.",
      "properties": {
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "ref": {
          "minLength": 3,
          "title": "Ref",
          "type": "string"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/ModelBenchRow"
          },
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "ref",
        "ok"
      ],
      "title": "ModelBenchDone",
      "type": "object"
    },
    "ModelBenchRow": {
      "additionalProperties": false,
      "description": "One shape at one count. ``each`` is the tokens per second of each call, ``total`` their sum,\n``window`` the seconds from the first start to the last end.",
      "properties": {
        "at_once": {
          "minimum": 1,
          "title": "At Once",
          "type": "integer"
        },
        "each": {
          "items": {
            "type": "number"
          },
          "title": "Each",
          "type": "array"
        },
        "shape": {
          "enum": [
            "tools",
            "prompt"
          ],
          "title": "Shape",
          "type": "string"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "number"
        },
        "window": {
          "minimum": 0,
          "title": "Window",
          "type": "number"
        }
      },
      "required": [
        "shape",
        "at_once",
        "each",
        "total",
        "window"
      ],
      "title": "ModelBenchRow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Server → every connection: a speed run ended. Not stored.",
  "properties": {
    "jsonrpc": {
      "const": "2.0",
      "default": "2.0",
      "title": "Jsonrpc",
      "type": "string"
    },
    "method": {
      "const": "model.bench.done",
      "default": "model.bench.done",
      "title": "Method",
      "type": "string"
    },
    "params": {
      "$ref": "#/$defs/ModelBenchDone"
    }
  },
  "required": [
    "params"
  ],
  "title": "ModelBenchDoneNotification",
  "type": "object"
}
