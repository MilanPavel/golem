{
  "$defs": {
    "DataColumn": {
      "additionalProperties": false,
      "description": "One column. The stats are null when unknown or hidden.",
      "properties": {
        "distinct": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distinct"
        },
        "max": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "min": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "null_fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Null Fraction"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "DataColumn",
      "type": "object"
    },
    "DataSavedQuery": {
      "additionalProperties": false,
      "description": "A query saved with a source.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "last_run_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Run At"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "sql": {
          "title": "Sql",
          "type": "string"
        }
      },
      "required": [
        "name",
        "sql"
      ],
      "title": "DataSavedQuery",
      "type": "object"
    },
    "DataSource": {
      "additionalProperties": false,
      "description": "One data source. ``location`` is for display and never holds a password.",
      "properties": {
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "kind": {
          "enum": [
            "builtin",
            "files",
            "sqlite",
            "duckdb",
            "postgres",
            "mysql",
            "url"
          ],
          "title": "Kind",
          "type": "string"
        },
        "location": {
          "title": "Location",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "needs_extension": {
          "anyOf": [
            {
              "enum": [
                "excel",
                "sqlite"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Needs Extension"
        },
        "notes_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes Path"
        },
        "privacy": {
          "enum": [
            "open",
            "local",
            "schema"
          ],
          "title": "Privacy",
          "type": "string"
        },
        "privacy_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Privacy Reason"
        },
        "project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        },
        "rows": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rows"
        },
        "scope": {
          "enum": [
            "builtin",
            "user",
            "project"
          ],
          "title": "Scope",
          "type": "string"
        },
        "status": {
          "enum": [
            "ready",
            "reading",
            "untrusted",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "tables": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tables"
        },
        "watch": {
          "default": false,
          "title": "Watch",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "kind",
        "scope",
        "location",
        "privacy",
        "status"
      ],
      "title": "DataSource",
      "type": "object"
    },
    "DataTable": {
      "additionalProperties": false,
      "description": "One table. ``rows`` is null when unknown or hidden.",
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/DataColumn"
          },
          "title": "Columns",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "rows": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rows"
        }
      },
      "required": [
        "name"
      ],
      "title": "DataTable",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The source with its tables, a sample, its notes and saved queries.",
  "properties": {
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "queries": {
      "items": {
        "$ref": "#/$defs/DataSavedQuery"
      },
      "title": "Queries",
      "type": "array"
    },
    "sample": {
      "additionalProperties": {
        "items": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": "array"
        },
        "type": "array"
      },
      "title": "Sample",
      "type": "object"
    },
    "source": {
      "$ref": "#/$defs/DataSource"
    },
    "tables": {
      "items": {
        "$ref": "#/$defs/DataTable"
      },
      "title": "Tables",
      "type": "array"
    }
  },
  "required": [
    "source",
    "tables",
    "sample"
  ],
  "title": "DataDescribeResult",
  "type": "object"
}
