{
  "$defs": {
    "Todo": {
      "additionalProperties": false,
      "description": "One step of the agent's plan.",
      "properties": {
        "id": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "in_progress",
            "done"
          ],
          "title": "Status",
          "type": "string"
        },
        "text": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "status"
      ],
      "title": "Todo",
      "type": "object"
    },
    "TodosUpdatedData": {
      "additionalProperties": false,
      "description": "The agent's todo list, whole, after ``todo_write`` replaced it.\n\n``call_id`` is the call that wrote it. It is null for a list a fork copied.\nAn empty list clears it.",
      "properties": {
        "call_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Call Id"
        },
        "todos": {
          "items": {
            "$ref": "#/$defs/Todo"
          },
          "title": "Todos",
          "type": "array"
        }
      },
      "required": [
        "todos"
      ],
      "title": "TodosUpdatedData",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The agent's todo list changed. ``run_id`` is null for a list a fork copied.",
  "properties": {
    "data": {
      "$ref": "#/$defs/TodosUpdatedData"
    },
    "run_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Run Id"
    },
    "seq": {
      "minimum": 1,
      "title": "Seq",
      "type": "integer"
    },
    "session_id": {
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "ts": {
      "minLength": 1,
      "title": "Ts",
      "type": "string"
    },
    "type": {
      "const": "todos.updated",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "seq",
    "session_id",
    "run_id",
    "ts",
    "type",
    "data"
  ],
  "title": "TodosUpdatedEvent",
  "type": "object"
}
