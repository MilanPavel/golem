{
  "$defs": {
    "WorkflowOutlineStep": {
      "additionalProperties": false,
      "description": "One step read from the source, without running it.\n\n``lines`` is the first and last line in the file (from 1). ``key`` and ``group`` are the\nstep's key and the group it belongs to, when the source says them. ``for_each`` and\n``condition`` are the source text of the loop and the guard. ``after`` lists the ids of the\nsteps this one follows.",
      "properties": {
        "after": {
          "items": {
            "type": "string"
          },
          "title": "After",
          "type": "array"
        },
        "agent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent"
        },
        "brief_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Brief Line"
        },
        "budget": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget"
        },
        "budget_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget Line"
        },
        "condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "for_each": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "For Each"
        },
        "gets": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gets"
        },
        "group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "lines": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Lines",
          "type": "array"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "lines"
      ],
      "title": "WorkflowOutlineStep",
      "type": "object"
    },
    "WorkflowProblem": {
      "additionalProperties": false,
      "description": "One finding of ``workflow.check``, with the line it is on and the outline step it belongs\nto (null for the header or the whole file). ``fix`` is a short replacement text or the name\nof an action.",
      "properties": {
        "fix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fix"
        },
        "line": {
          "minimum": 1,
          "title": "Line",
          "type": "integer"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        },
        "step_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Id"
        }
      },
      "required": [
        "severity",
        "line",
        "message"
      ],
      "title": "WorkflowProblem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The problems, in line order, and the outline steps of the checked text.",
  "properties": {
    "problems": {
      "items": {
        "$ref": "#/$defs/WorkflowProblem"
      },
      "title": "Problems",
      "type": "array"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/WorkflowOutlineStep"
      },
      "title": "Steps",
      "type": "array"
    }
  },
  "title": "WorkflowCheckResult",
  "type": "object"
}
