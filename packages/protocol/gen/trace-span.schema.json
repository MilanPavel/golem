      "title": "TraceTokens",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One run, model call, or tool call, without its children.\n\n``id`` is the run id for a run, the assistant ``message_id`` for a model\ncall, and the ``call_id`` for a tool call. ``end`` is null while the span\nis open, or when its run was cut off. ``duration_ms`` is the model's\nlatency or the tool's own time when the daemon measured it, else\n``end - start``. ``approval_wait_ms`` is the time a tool call waited for\nthe user. ``recorded`` is false for a model span rebuilt from the message\nevents of a session that has no ``model.call.*`` events.",
  "properties": {
    "approval_wait_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approval Wait Ms"
    },
    "duration_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Ms"
    },
    "end": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End"
    },
    "first_token_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "First Token Ms"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "run",
        "model",
        "tool"
      ],
      "title": "Kind",
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "preview": {
      "default": "",
      "maxLength": 200,
      "title": "Preview",
      "type": "string"
    },
    "recorded": {
      "default": true,
      "title": "Recorded",
      "type": "boolean"
    },
    "start": {
      "minLength": 1,
      "title": "Start",
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "failed",
        "cancelled",
        "denied",
        "running"
      ],
      "title": "Status",
      "type": "string"
    },
    "tokens": {
      "anyOf": [
        {
          "$ref": "#/$defs/TraceTokens"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
