{
  "$defs": {
    "ApprovalNeededData": {
      "additionalProperties": false,
      "description": "A tool call waits for the user. The run is paused until ``approval.respond``.\n\n``source`` is the rule that asked, such as ``built-in default``.\n``subject`` is what rules match for this tool, such as the shell command.",
      "properties": {
        "args": {
          "additionalProperties": true,
          "title": "Args",
          "type": "object"
        },
        "call_id": {
          "minLength": 1,
          "title": "Call Id",
          "type": "string"
        },
        "message_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message Id"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        }
      },
      "required": [
        "call_id",
        "name",
        "args",
        "source"
      ],
      "title": "ApprovalNeededData",
      "type": "object"
    },
    "ApprovalNeededEvent": {
      "additionalProperties": false,
      "description": "The run is waiting for an answer about one tool call.",
      "properties": {
        "data": {
          "$ref": "#/$defs/ApprovalNeededData"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "ts": {
          "minLength": 1,
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "approval.needed",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "session_id",
        "run_id",
        "ts",
        "type",
        "data"
      ],
      "title": "ApprovalNeededEvent",
      "type": "object"
    },
    "ApprovalResolvedData": {
      "additionalProperties": false,
      "description": "The user answered.\n\n``allow_session`` also allows ``name`` with this ``subject`` for the rest of\nthe session, or every call of ``name`` when ``subject`` is null.\n``allow_always`` wrote an allow rule, and ``rule`` names it.",
      "properties": {
        "call_id": {
          "minLength": 1,
          "title": "Call Id",
          "type": "string"
        },
        "decision": {
          "enum": [
            "allow",
            "allow_session",
            "allow_always",
            "deny"
          ],
          "title": "Decision",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        }
      },
      "required": [
        "call_id",
        "name",
        "decision"
      ],
      "title": "ApprovalResolvedData",
      "type": "object"
    },
    "ApprovalResolvedEvent": {
      "additionalProperties": false,
      "description": "The waiting tool call was answered, and the run goes on.",
      "properties": {
        "data": {
          "$ref": "#/$defs/ApprovalResolvedData"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "ts": {
          "minLength": 1,
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "approval.resolved",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "session_id",
        "run_id",
        "ts",
        "type",
        "data"
      ],
      "title": "ApprovalResolvedEvent",
      "type": "object"
    },
    "EmptyEventData": {
      "additionalProperties": false,
      "description": "No payload. Used by ``run.started``, ``run.completed``, and ``session.closed``.",
      "properties": {},
      "title": "EmptyEventData",
      "type": "object"
    },
    "ForkedFrom": {
      "additionalProperties": false,
      "description": "The session and message a fork was copied from.",
      "properties": {
        "message_id": {
          "minLength": 1,
          "title": "Message Id",
          "type": "string"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "message_id"
      ],
      "title": "ForkedFrom",
      "type": "object"
    },
    "MessageCompletedData": {
      "additionalProperties": false,
      "description": "Full text of a user or assistant message.\n\n``interrupted`` is true when the run stopped before the model finished.\n``text`` is then what had streamed so far.",
      "properties": {
        "interrupted": {
          "default": false,
          "title": "Interrupted",
          "type": "boolean"
        },
        "message_id": {
          "minLength": 1,
          "title": "Message Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "role",
        "text"
      ],
      "title": "MessageCompletedData",
      "type": "object"
    },
    "MessageCompletedEvent": {
      "additionalProperties": false,
      "description": "The full text of one message. Replaces any deltas for that id.",
      "properties": {
        "data": {
          "$ref": "#/$defs/MessageCompletedData"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "ts": {
          "minLength": 1,
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "message.completed",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "session_id",
        "run_id",
        "ts",
        "type",
        "data"
      ],
      "title": "MessageCompletedEvent",
      "type": "object"
    },
    "MessageDeltaData": {
      "additionalProperties": false,
      "description": "One incremental fragment of an assistant message.",
      "properties": {
        "message_id": {
          "minLength": 1,
          "title": "Message Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "text"
      ],
      "title": "MessageDeltaData",
      "type": "object"
    },
    "MessageDeltaEvent": {
      "additionalProperties": false,
      "description": "Tokens to append to the open assistant message.",
      "properties": {
        "data": {
          "$ref": "#/$defs/MessageDeltaData"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "ts": {
          "minLength": 1,
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "message.delta",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "session_id",
        "run_id",
        "ts",
        "type",
        "data"
      ],
      "title": "MessageDeltaEvent",
      "type": "object"
    },
    "MessageStartedData": {
      "additionalProperties": false,
      "description": "An assistant message is open and tokens may follow.",
      "properties": {
        "message_id": {
          "minLength": 1,
          "title": "Message Id",
          "type": "string"
        },
        "role": {
          "const": "assistant",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "role"
      ],
      "title": "MessageStartedData",
      "type": "object"
    },
    "MessageStartedEvent": {
      "additionalProperties": false,
      "description": "The assistant bubble is open.",
      "properties": {
        "data": {
          "$ref": "#/$defs/MessageStartedData"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "ts": {
          "minLength": 1,
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "message.started",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "session_id",
        "run_id",
        "ts",
        "type",
        "data"
      ],
      "title": "MessageStartedEvent",
      "type": "object"
    },
    "ModelSelectedData": {
      "additionalProperties": false,
      "description": "The model the session's next run uses.\n\n``model_profile`` is the name asked for, a profile or a ``provider/model``\nref. ``model_provider`` and ``model_name`` are what it resolved to when it\nwas chosen. ``reason`` ``user`` is ``session.set_model``.",
      "properties": {
        "model_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Name"
        },
        "model_profile": {
          "minLength": 1,
          "title": "Model Profile",
          "type": "string"
        },
        "model_provider": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Provider"
        },
        "reason": {
          "const": "user",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "model_profile",
        "reason"
      ],
      "title": "ModelSelectedData",
      "type": "object"
    },
    "ModelSelectedEvent": {
      "additionalProperties": false,
      "description": "The session switched models.\n\nIt applies from the next run. A run in progress keeps its model.",
      "properties": {
        "data": {
          "$ref": "#/$defs/ModelSelectedData"
        },
        "run_id": {
          "title": "Run Id",
          "type": "null"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "ts": {
          "minLength": 1,
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "model.selected",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "session_id",
        "run_id",
        "ts",
        "type",
        "data"
      ],
      "title": "ModelSelectedEvent",
      "type": "object"
    },
    "RunCancelledData": {
      "additionalProperties": false,
      "description": "Who stopped the run. ``user`` is ``run.cancel``, ``shutdown`` the daemon stopping.",
      "properties": {
        "reason": {
          "enum": [
            "user",
            "shutdown"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "title": "RunCancelledData",
      "type": "object"
    },
    "RunCancelledEvent": {
      "additionalProperties": false,
      "description": "The run was stopped before the model finished. The partial reply is kept.",
      "properties": {
        "data": {
          "$ref": "#/$defs/RunCancelledData"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "ts": {
          "minLength": 1,
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "run.cancelled",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "session_id",
        "run_id",
        "ts",
        "type",
        "data"
      ],
      "title": "RunCancelledEvent",
      "type": "object"
    },
    "RunCompletedEvent": {
      "additionalProperties": false,
      "description": "The graph run finished and the checkpoint is current.",
      "properties": {
        "data": {
          "$ref": "#/$defs/EmptyEventData"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "ts": {
          "minLength": 1,
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "run.completed",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "session_id",
        "run_id",
        "ts",
        "type",
        "data"
      ],
      "title": "RunCompletedEvent",
      "type": "object"
    },
    "RunFailedData": {
      "additionalProperties": false,
      "description": "Why a run stopped. No traceback.",
      "properties": {
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "title": "RunFailedData",
      "type": "object"
    },
    "RunFailedEvent": {
      "additionalProperties": false,
      "description": "The graph run stopped with an error.",
      "properties": {
        "data": {
          "$ref": "#/$defs/RunFailedData"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "ts": {
          "minLength": 1,
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "run.failed",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "session_id",
        "run_id",
        "ts",
        "type",
        "data"
      ],
      "title": "RunFailedEvent",
      "type": "object"
    },
    "RunStartedEvent": {
      "additionalProperties": false,
      "description": "A graph run is in progress for this session.",
      "properties": {
        "data": {
          "$ref": "#/$defs/EmptyEventData"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "ts": {
          "minLength": 1,
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "run.started",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "session_id",
        "run_id",
        "ts",
        "type",
        "data"
      ],
      "title": "RunStartedEvent",
      "type": "object"
    },
    "SessionAllowance": {
      "additionalProperties": false,
      "description": "A tool allowed for the rest of a session. ``subject`` null allows every call of it.",
      "properties": {
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        },
        "tool": {
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool"
      ],
      "title": "SessionAllowance",
      "type": "object"
    },
    "SessionClosedEvent": {
      "additionalProperties": false,
      "description": "The session left the list. ``run_id`` is null: no run owns the change.\n\nThe earlier events stay in the log. ``session.list`` hides the session.",
      "properties": {
        "data": {
          "$ref": "#/$defs/EmptyEventData"
        },
        "run_id": {
          "title": "Run Id",
          "type": "null"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "ts": {
          "minLength": 1,
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "session.closed",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "session_id",
        "run_id",
        "ts",
        "type",
        "data"
      ],
      "title": "SessionClosedEvent",
      "type": "object"
    },
    "SessionCreatedData": {
      "additionalProperties": false,
      "description": "Profile stored for a new session.\n\n``model_profile`` is a profile name or a ``provider/model`` ref.\n``model_provider`` and ``model_name`` are set when the daemon can resolve\nit, and null otherwise. ``forked_from`` is set on a session made by\n``session.fork``. ``cwd`` is the project folder the file tools work in,\nor null for a session without one.",
      "properties": {
        "cwd": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cwd"
        },
        "forked_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/ForkedFrom"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Name"
        },
        "model_profile": {
          "minLength": 1,
          "title": "Model Profile",
          "type": "string"
        },
        "model_provider": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Provider"
        }
      },
      "required": [
        "model_profile"
      ],
      "title": "SessionCreatedData",
      "type": "object"
    },
    "SessionCreatedEvent": {
      "additionalProperties": false,
      "description": "A session exists. ``run_id`` is null because no run has started.",
      "properties": {
        "data": {
          "$ref": "#/$defs/SessionCreatedData"
        },
        "run_id": {
          "title": "Run Id",
          "type": "null"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "ts": {
          "minLength": 1,
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "session.created",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "session_id",
        "run_id",
        "ts",
        "type",
        "data"
      ],
      "title": "SessionCreatedEvent",
      "type": "object"
    },
    "SessionUpdatedData": {
      "additionalProperties": false,
      "description": "A session attribute changed: its title, its project folder, or its allowed tools.\n\nA field left null did not change. ``cwd`` is set once, on a session made\nbefore sessions had a folder, by the first ``message.send`` that names one.\n``allowed_tools`` is the whole list after ``session.revoke``.",
      "properties": {
        "allowed_tools": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/SessionAllowance"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Tools"
        },
        "cwd": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cwd"
        },
        "title": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "title": "SessionUpdatedData",
      "type": "object"
    },
    "SessionUpdatedEvent": {
      "additionalProperties": false,
      "description": "The session got a title. ``run_id`` is null: no run owns the change.",
      "properties": {
        "data": {
          "$ref": "#/$defs/SessionUpdatedData"
        },
        "run_id": {
          "title": "Run Id",
          "type": "null"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "ts": {
          "minLength": 1,
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "session.updated",
          "title": "Type",
          "type": "string"
        }
      },
