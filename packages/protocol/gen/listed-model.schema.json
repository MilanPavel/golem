{
  "$defs": {
    "ModelPriceInfo": {
      "additionalProperties": false,
      "description": "USD per million tokens. A local model is zero.",
      "properties": {
        "cached_input": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cached Input"
        },
        "input": {
          "minimum": 0,
          "title": "Input",
          "type": "number"
        },
        "output": {
          "minimum": 0,
          "title": "Output",
          "type": "number"
        }
      },
      "required": [
        "input",
        "output"
      ],
      "title": "ModelPriceInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One model, by ``provider/model`` ref.\n\n``source`` is where golem found it: ``installed`` on a local server,\n``catalog`` for a local model to download, ``remote`` from a provider's\nlist, or ``profile`` when only config names it. ``profiles`` are the\nprofile names that point at it. ``fit`` says whether a local model fits\nin this machine's memory. ``stale`` means a cached list was shown because\nthe provider did not answer in time.",
  "properties": {
    "ctx": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ctx"
    },
    "fit": {
      "anyOf": [
        {
          "enum": [
            "fits",
            "tight",
            "too_big"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fit"
    },
    "label": {
      "minLength": 1,
      "title": "Label",
      "type": "string"
    },
    "price": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelPriceInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "profiles": {
      "items": {
        "type": "string"
      },
      "title": "Profiles",
      "type": "array"
    },
    "provider": {
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "ref": {
      "minLength": 3,
      "title": "Ref",
      "type": "string"
    },
    "size_gb": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Size Gb"
    },
    "source": {
      "enum": [
        "installed",
        "catalog",
        "remote",
        "profile"
      ],
      "title": "Source",
      "type": "string"
    },
    "stale": {
      "default": false,
      "title": "Stale",
      "type": "boolean"
    },
    "status": {
      "enum": [
        "ready",
        "needs_key",
        "not_installed",
        "server_down"
      ],
      "title": "Status",
      "type": "string"
    },
    "tools": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tools"
    }
  },
  "required": [
    "ref",
    "label",
    "provider",
    "source",
    "status"
  ],
  "title": "ListedModel",
  "type": "object"
}
