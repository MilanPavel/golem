{
  "$defs": {
    "ModelPriceInfo": {
      "additionalProperties": false,
      "description": "USD per million tokens. A local model is zero.",
      "properties": {
        "cached_input": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cached Input"
        },
        "input": {
          "minimum": 0,
          "title": "Input",
          "type": "number"
        },
        "output": {
          "minimum": 0,
          "title": "Output",
          "type": "number"
        }
      },
      "required": [
        "input",
        "output"
      ],
      "title": "ModelPriceInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One model, by ``provider/model`` ref.\n\n``source`` is where golem found it: ``installed`` on a local server,\n``catalog`` for a local model to download, ``remote`` from a provider's\nlist, or ``profile`` when only config names it. ``progress`` is set while\nit is ``pulling``. ``profiles`` are the profile names that point at it.\n``fit`` says whether a local model fits in this machine's memory.\n``tags`` are a catalog model's tags, such as ``coding``, and\n``recommended`` marks the one catalog model golem suggests for this Mac.\n``categories`` say what the model is for, in a fixed order: the catalog's\nown for a model it lists, else what Ollama's ``capabilities`` and\nLiteLLM's ``supports_*`` fields and context size show.\n``recommended_for`` lists the categories this catalog model is the pick for on\nthis Mac: the largest model of that category it has the memory for.\n``stale`` means a cached list was shown because the provider did not\nanswer in time.",
  "properties": {
    "categories": {
      "items": {
        "enum": [
          "general",
          "coding",
          "reasoning",
          "vision",
          "fast",
          "long-context"
        ],
        "type": "string"
      },
      "title": "Categories",
      "type": "array"
    },
    "ctx": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ctx"
    },
    "fit": {
      "anyOf": [
        {
          "enum": [
            "fits",
            "tight",
            "too_big"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fit"
    },
    "label": {
      "minLength": 1,
      "title": "Label",
      "type": "string"
    },
    "price": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelPriceInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "profiles": {
      "items": {
        "type": "string"
      },
      "title": "Profiles",
      "type": "array"
    },
    "progress": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Progress"
    },
    "provider": {
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "recommended": {
      "default": false,
      "title": "Recommended",
      "type": "boolean"
    },
    "recommended_for": {
      "items": {
        "enum": [
          "general",
          "coding",
          "reasoning",
          "vision",
          "fast",
          "long-context"
        ],
        "type": "string"
      },
      "title": "Recommended For",
      "type": "array"
    },
    "ref": {
      "minLength": 3,
      "title": "Ref",
      "type": "string"
    },
    "size_gb": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Size Gb"
    },
    "source": {
      "enum": [
        "installed",
        "catalog",
        "remote",
        "profile"
      ],
      "title": "Source",
      "type": "string"
    },
    "stale": {
      "default": false,
      "title": "Stale",
      "type": "boolean"
    },
    "status": {
      "enum": [
        "ready",
        "needs_key",
        "not_installed",
        "server_down",
        "pulling"
      ],
      "title": "Status",
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "tools": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tools"
    }
  },
  "required": [
    "ref",
    "label",
    "provider",
    "source",
    "status"
  ],
  "title": "ListedModel",
  "type": "object"
}
