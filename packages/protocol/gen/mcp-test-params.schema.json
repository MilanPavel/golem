{
  "$defs": {
    "McpServerConfig": {
      "additionalProperties": false,
      "description": "Every field of ``[mcp.<name>]``, as it goes over the wire.\n\nThe daemon's settings model has the same fields, and a test keeps the two\nequal. A value in ``env`` or ``headers`` names a secret as\n``keychain:mcp/<name>``, never the secret itself.",
      "properties": {
        "approval": {
          "default": "ask",
          "enum": [
            "ask",
            "allow"
          ],
          "title": "Approval",
          "type": "string"
        },
        "args": {
          "items": {
            "type": "string"
          },
          "title": "Args",
          "type": "array"
        },
        "command": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "cwd": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cwd"
        },
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "const": "on_demand",
              "type": "string"
            }
          ],
          "default": true,
          "title": "Enabled"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Env",
          "type": "object"
        },
        "env_passthrough": {
          "items": {
            "type": "string"
          },
          "title": "Env Passthrough",
          "type": "array"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Headers",
          "type": "object"
        },
        "timeout_seconds": {
          "default": 120,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "tools": {
          "$ref": "#/$defs/McpToolFilterConfig"
        },
        "url": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "title": "McpServerConfig",
      "type": "object"
    },
    "McpToolFilterConfig": {
      "additionalProperties": false,
      "description": "``tools`` of ``[mcp.<name>]``: ``fnmatch`` patterns on the server's own tool names.\n\nAn empty ``include`` means every tool, and ``exclude`` wins.",
      "properties": {
        "exclude": {
          "items": {
            "type": "string"
          },
          "title": "Exclude",
          "type": "array"
        },
        "include": {
          "items": {
            "type": "string"
          },
          "title": "Include",
          "type": "array"
        }
      },
      "title": "McpToolFilterConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``mcp.test``. Start a server, list its tools, and ping it, without saving anything.\n\nGive ``name`` for a saved server, or ``config`` for one not saved yet, not\nboth. ``secrets`` (by reference, ``mcp/github``) are used for this test\nfirst and then the Keychain, and are never stored. ``test_id`` ties the\n``mcp.test.progress`` notifications to this call.",
  "properties": {
    "config": {
      "anyOf": [
        {
          "$ref": "#/$defs/McpServerConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "name": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "secrets": {
      "additionalProperties": {
        "format": "password",
        "type": "string",
        "writeOnly": true
      },
      "title": "Secrets",
      "type": "object"
    },
    "session_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    },
    "test_id": {
      "minLength": 1,
      "title": "Test Id",
      "type": "string"
    }
  },
  "required": [
    "test_id"
  ],
  "title": "McpTestParams",
  "type": "object"
}
