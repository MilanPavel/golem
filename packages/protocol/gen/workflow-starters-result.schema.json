{
  "$defs": {
    "WorkflowStarterInfo": {
      "additionalProperties": false,
      "description": "One starter workflow golem ships. ``needs_folder`` says it reads a project, so it goes\nin that project's ``workflows`` folder; the others go in the user's. ``routine`` is the\nroutine that can be added with it.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "line": {
          "title": "Line",
          "type": "string"
        },
        "needs_folder": {
          "title": "Needs Folder",
          "type": "boolean"
        },
        "routine": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkflowStarterRoutine"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schedule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schedule"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "line",
        "needs_folder"
      ],
      "title": "WorkflowStarterInfo",
      "type": "object"
    },
    "WorkflowStarterRoutine": {
      "additionalProperties": false,
      "description": "The routine that comes with a starter: ``name`` and ``schedule`` as ``routine.update``\ntakes them, and ``words`` as a short phrase for the card (\"every weekday at 07:30\").",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schedule": {
          "minLength": 1,
          "title": "Schedule",
          "type": "string"
        },
        "words": {
          "minLength": 1,
          "title": "Words",
          "type": "string"
        }
      },
      "required": [
        "name",
        "schedule",
        "words"
      ],
      "title": "WorkflowStarterRoutine",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "starters": {
      "items": {
        "$ref": "#/$defs/WorkflowStarterInfo"
      },
      "title": "Starters",
      "type": "array"
    }
  },
  "required": [
    "starters"
  ],
  "title": "WorkflowStartersResult",
  "type": "object"
}
