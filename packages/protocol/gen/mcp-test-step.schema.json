    "detail": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Detail"
    },
    "elapsed_ms": {
      "default": 0,
      "minimum": 0,
      "title": "Elapsed Ms",
      "type": "integer"
    },
    "state": {
      "enum": [
        "running",
        "ok",
        "failed",
        "skipped"
      ],
      "title": "State",
      "type": "string"
    },
    "step": {
      "enum": [
        "resolve",
        "spawn",
        "connect",
        "initialize",
        "tools",
        "ping"
      ],
      "title": "Step",
      "type": "string"
    }
  },
  "required": [
    "step",
    "state"
  ],
  "title": "McpTestStep",
  "type": "object"
}
