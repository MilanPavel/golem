{
  "additionalProperties": false,
  "description": "A request went to the model.\n\n``message_id`` is the assistant reply's id, which identifies the model\ncall. ``index`` counts the calls of this run from 1. ``provider`` and\n``model`` are None when the profile does not resolve.\n\n``system_prompt_sha`` and ``tools_sha`` are the sha256 of the system\nprompt and of the tool schemas (compact JSON, sorted keys) sent with the\ncall, which the daemon keeps by hash. Each is None when it was not sent.\n``message_ids`` are the history messages sent, in order, not counting the\nsystem prompt.",
  "properties": {
    "index": {
      "minimum": 1,
      "title": "Index",
      "type": "integer"
    },
    "message_id": {
      "minLength": 1,
      "title": "Message Id",
      "type": "string"
    },
    "message_ids": {
      "items": {
        "type": "string"
      },
      "title": "Message Ids",
      "type": "array"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "profile": {
      "minLength": 1,
      "title": "Profile",
      "type": "string"
    },
    "provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider"
    },
    "system_prompt_sha": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "System Prompt Sha"
    },
    "tools_sha": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tools Sha"
    }
  },
  "required": [
    "message_id",
    "index",
    "profile"
  ],
  "title": "ModelCallStartedData",
  "type": "object"
}
