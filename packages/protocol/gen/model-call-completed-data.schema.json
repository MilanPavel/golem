  "additionalProperties": false,
  "description": "A model call ended.\n\n``first_token_ms`` is the time from the request to the first text, and\nNone when no text came. ``latency_ms`` is the time to the end.\n``failed`` is true when the call raised or was stopped.\n\n``context_window`` is the window the call ran with, read from the model server\nafter the call. Exact. None when it could not be read.\n\n``text_tool_calls`` is set when the model wrote a tool call as text in its\nreply. ``recovered`` means golem turned the text into tool calls. ``unread``\nmeans the text held a call golem could not read, so the reply stayed text.\nNone when the reply had no such text.\n\n``cost_usd`` is the cost of this call at ``price``. Both are None when the\nprice is not known. A local model costs 0.\n\n``load_ms``, ``prompt_ms`` and ``reply_ms`` are the time the model server spent loading\nthe model, reading the prompt and writing the reply. From the model server's own clock.\nOllama only.",
  "properties": {
    "context_window": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context Window"
    },
    "cost_usd": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost Usd"
    },
    "failed": {
      "default": false,
      "title": "Failed",
      "type": "boolean"
    },
    "first_token_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "First Token Ms"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "integer"
    },
    "load_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Load Ms"
    },
    "message_id": {
      "minLength": 1,
      "title": "Message Id",
      "type": "string"
    },
    "price": {
      "anyOf": [
        {
          "$ref": "#/$defs/CallPrice"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "prompt_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Ms"
    },
    "reply_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reply Ms"
    },
    "stop_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stop Reason"
    },
    "text_tool_calls": {
      "anyOf": [
        {
          "enum": [
            "recovered",
            "unread"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Text Tool Calls"
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/TokenUsage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "message_id",
    "latency_ms"
  ],
  "title": "ModelCallCompletedData",
  "type": "object"
}
