{
  "$defs": {
    "WorkflowRunInfo": {
      "additionalProperties": false,
      "description": "One run of a workflow, from its ``workflow_runs`` row.\n\nThe times are ISO 8601 with an offset. ``session_id`` is the run's headless session.\n``error`` says why a ``failed`` run failed.",
      "properties": {
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "session_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "waiting",
            "done",
            "failed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "trigger": {
          "title": "Trigger",
          "type": "string"
        },
        "workflow_id": {
          "minLength": 1,
          "title": "Workflow Id",
          "type": "string"
        },
        "workflow_run_id": {
          "minLength": 1,
          "title": "Workflow Run Id",
          "type": "string"
        }
      },
      "required": [
        "workflow_run_id",
        "workflow_id",
        "name",
        "status",
        "trigger"
      ],
      "title": "WorkflowRunInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The run as it was when it was continued; its steps arrive as ``workflow.step.*``.",
  "properties": {
    "run": {
      "$ref": "#/$defs/WorkflowRunInfo"
    }
  },
  "required": [
    "run"
  ],
  "title": "WorkflowResumeResult",
  "type": "object"
}
