{
  "$defs": {
    "ModelCallCompletedData": {
      "additionalProperties": false,
      "description": "A model call ended.\n\n``first_token_ms`` is the time from the request to the first text, and\nNone when no text came. ``latency_ms`` is the time to the end.\n``failed`` is true when the call raised or was stopped.\n\n``context_window`` is the window the call ran with, read from the model server\nafter the call. Exact. None when it could not be read.\n\n``text_tool_calls`` is set when the model wrote a tool call as text in its\nreply. ``recovered`` means golem turned the text into tool calls. ``unread``\nmeans the text held a call golem could not read, so the reply stayed text.\nNone when the reply had no such text.",
      "properties": {
        "context_window": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Window"
        },
        "failed": {
          "default": false,
          "title": "Failed",
          "type": "boolean"
        },
        "first_token_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Token Ms"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "message_id": {
          "minLength": 1,
          "title": "Message Id",
          "type": "string"
        },
        "stop_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop Reason"
        },
        "text_tool_calls": {
          "anyOf": [
            {
              "enum": [
                "recovered",
                "unread"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Tool Calls"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/TokenUsage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "message_id",
        "latency_ms"
      ],
      "title": "ModelCallCompletedData",
      "type": "object"
    },
    "TokenUsage": {
      "additionalProperties": false,
      "description": "Tokens one model call used. A field is None when the provider did not report it.",
      "properties": {
        "cache_read": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Read"
        },
        "cache_write": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Write"
        },
        "input": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input"
        },
        "output": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output"
        }
      },
      "title": "TokenUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The model call ended. Comes before the call's ``tool.requested`` events.",
  "properties": {
    "data": {
      "$ref": "#/$defs/ModelCallCompletedData"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "seq": {
      "minimum": 1,
      "title": "Seq",
      "type": "integer"
    },
    "session_id": {
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "ts": {
      "minLength": 1,
      "title": "Ts",
      "type": "string"
    },
    "type": {
      "const": "model.call.completed",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "seq",
    "session_id",
    "run_id",
    "ts",
    "type",
    "data"
  ],
  "title": "ModelCallCompletedEvent",
  "type": "object"
}
