{
  "$defs": {
    "ModelOption": {
      "additionalProperties": false,
      "description": "One row of the option table: what an option may be, and what it does.\n\n``kind`` ``duration`` is a time such as ``5m``, or a number of seconds, and\n``-1`` for always. ``default`` is Ollama's own, and ``None`` when it has\nnone, as for the seed.",
      "properties": {
        "default": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        },
        "kind": {
          "enum": [
            "float",
            "int",
            "duration"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "long": {
          "minLength": 1,
          "title": "Long",
          "type": "string"
        },
        "maximum": {
          "title": "Maximum",
          "type": "number"
        },
        "minimum": {
          "title": "Minimum",
          "type": "number"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "short": {
          "minLength": 1,
          "title": "Short",
          "type": "string"
        },
        "step": {
          "exclusiveMinimum": 0,
          "title": "Step",
          "type": "number"
        }
      },
      "required": [
        "name",
        "label",
        "kind",
        "minimum",
        "maximum",
        "step",
        "short",
        "long"
      ],
      "title": "ModelOption",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The table, and each option's value from the model's own default up.\n\n``defaults`` are the model's own values from Ollama, and Ollama's for what the\nmodel leaves out. ``saved`` is what ``model.options.set`` stored for the model.\n``session`` is the session's overrides, or ``None`` when no session was asked for.\nThe value in use is the session's, else the saved, else the default.",
  "properties": {
    "defaults": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ]
      },
      "title": "Defaults",
      "type": "object"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "options": {
      "items": {
        "$ref": "#/$defs/ModelOption"
      },
      "title": "Options",
      "type": "array"
    },
    "saved": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ]
      },
      "title": "Saved",
      "type": "object"
    },
    "session": {
      "anyOf": [
        {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session"
    }
  },
  "required": [
    "model",
    "options",
    "defaults",
    "saved"
  ],
  "title": "ModelOptionsGetResult",
  "type": "object"
}
