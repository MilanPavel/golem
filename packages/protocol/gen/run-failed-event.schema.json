{
  "$defs": {
    "RunFailedData": {
      "additionalProperties": false,
      "description": "Why a run stopped. No traceback.\n\n``code`` names a failure a client can act on. ``model_unreachable``: the\nmodel's server did not answer. ``not_installed``: the model needs a local\nserver that is not installed, such as Ollama. ``budget_spent``: a cap in\n``[budget]`` is spent, so a paid call was not made. ``provider`` is the\nprovider whose server it was, and ``hint`` says how to fix it, such as\n``run ollama serve``. ``context_full``: the prompt does not fit the model's window,\neven after clearing and summarising, and nothing was sent. ``local_only``: the chat's\nfolder stays on this Mac and a hosted model was about to be called, so nothing was sent.",
      "properties": {
        "code": {
          "anyOf": [
            {
              "enum": [
                "model_unreachable",
                "not_installed",
                "context_full",
                "budget_spent",
                "local_only"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "hint": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hint"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        }
      },
      "required": [
        "message"
      ],
      "title": "RunFailedData",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The graph run stopped with an error.",
  "properties": {
    "data": {
      "$ref": "#/$defs/RunFailedData"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "seq": {
      "minimum": 1,
      "title": "Seq",
      "type": "integer"
    },
    "session_id": {
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "ts": {
      "minLength": 1,
      "title": "Ts",
      "type": "string"
    },
    "type": {
      "const": "run.failed",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "seq",
    "session_id",
    "run_id",
    "ts",
    "type",
    "data"
  ],
  "title": "RunFailedEvent",
  "type": "object"
}
