{
  "$defs": {
    "DeviceInfo": {
      "additionalProperties": false,
      "description": "One phone in the registry. A revoked one stays, with ``revoked_at`` set.\n\n``rules`` counts the \"Always allow\" rules the phone made, which stay after a revoke.",
      "properties": {
        "id": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Id",
          "type": "string"
        },
        "last_seen": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Seen"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "paired_at": {
          "title": "Paired At",
          "type": "string"
        },
        "revoked_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revoked At"
        },
        "rules": {
          "default": 0,
          "minimum": 0,
          "title": "Rules",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "paired_at"
      ],
      "title": "DeviceInfo",
      "type": "object"
    },
    "DeviceRule": {
      "additionalProperties": false,
      "description": "A rule a phone wrote with \"Always allow\", and when.",
      "properties": {
        "at": {
          "title": "At",
          "type": "string"
        },
        "rule": {
          "title": "Rule",
          "type": "string"
        }
      },
      "required": [
        "rule",
        "at"
      ],
      "title": "DeviceRule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``revoked`` is false when the device was already revoked. ``rules`` stay in Tool rules.",
  "properties": {
    "device": {
      "$ref": "#/$defs/DeviceInfo"
    },
    "revoked": {
      "title": "Revoked",
      "type": "boolean"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/DeviceRule"
      },
      "title": "Rules",
      "type": "array"
    }
  },
  "required": [
    "device",
    "revoked",
    "rules"
  ],
  "title": "DeviceRevokeResult",
  "type": "object"
}
