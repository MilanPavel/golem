{
  "$defs": {
    "ModelCallStartedData": {
      "additionalProperties": false,
      "description": "A request went to the model.\n\n``message_id`` is the assistant reply's id, which identifies the model\ncall. ``index`` counts the calls of this run from 1. ``provider`` and\n``model`` are None when the profile does not resolve.",
