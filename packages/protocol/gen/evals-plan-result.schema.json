{
  "$defs": {
    "EvalAsk": {
      "additionalProperties": false,
      "description": "One ask of the set, as a person can read it before and after a measurement.\n\n``text`` is the message sent to the model. ``facts`` is what a good answer must mention, each\nas a readable string (``a or b`` holds when either is there). ``setup`` is one short line on\nwhat the ask is set up with, and ``why`` says in plain words why it is in the set (``reason``\nis the same as a code).",
      "properties": {
        "facts": {
          "items": {
            "type": "string"
          },
          "title": "Facts",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "reason": {
          "default": "none",
          "enum": [
            "none",
            "window",
            "at_once",
            "model"
          ],
          "title": "Reason",
          "type": "string"
        },
        "setup": {
          "default": "",
          "title": "Setup",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "why": {
          "default": "",
          "title": "Why",
          "type": "string"
        }
      },
      "required": [
        "name",
        "text"
      ],
      "title": "EvalAsk",
      "type": "object"
    },
    "EvalModelChoice": {
      "additionalProperties": false,
      "description": "A model an arm may use instead of its own. ``size_gb`` is its size in memory, if known.",
      "properties": {
        "ref": {
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        },
        "size_gb": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Gb"
        }
      },
      "required": [
        "ref"
      ],
      "title": "EvalModelChoice",
      "type": "object"
    },
    "EvalPlanArm": {
      "additionalProperties": false,
      "description": "One arm of a measurement as ``evals.plan`` sees it now.\n\n``kind`` is ``local`` for a model on this machine and ``cloud`` for a paid one. ``model`` is\nthe model it would use, and ``choices`` the others it could use. A local arm has the memory\nnumbers and a ``verdict``; ``needed_gb`` is what the model needs at this window, ``ram_gb``\nthe machine's memory and ``free_gb`` what is free now, each null when it could not be read.\n``loaded_gb`` is what Ollama already holds in memory for that model (null when it is not\nloaded); it is not counted as missing. ``runnable`` is false when the arm cannot run at all,\nwhatever the person says: a hosted model without a key, or a local model that Ollama does not\nhave. A cloud arm has none of the memory numbers and may have ``cost_usd``, the estimate for\nall its runs. ``reason`` is one plain line on the verdict, or on the cost. ``asks`` is how\nmany asks it plays (twice each: with helpers and without), and ``minutes`` a rough time for\nthe arm.",
      "properties": {
        "asks": {
          "minimum": 1,
          "title": "Asks",
          "type": "integer"
        },
        "choices": {
          "items": {
            "$ref": "#/$defs/EvalModelChoice"
          },
          "title": "Choices",
          "type": "array"
        },
        "cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "free_gb": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Free Gb"
        },
        "kind": {
          "enum": [
            "local",
            "cloud"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "loaded_gb": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Loaded Gb"
        },
        "minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minutes"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "needed_gb": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Needed Gb"
        },
        "ram_gb": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ram Gb"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "runnable": {
          "default": true,
          "title": "Runnable",
          "type": "boolean"
        },
        "tier": {
          "enum": [
            "local",
            "budget",
            "frontier"
          ],
          "title": "Tier",
          "type": "string"
        },
        "verdict": {
          "anyOf": [
            {
              "enum": [
                "fits",
                "tight",
                "too_big",
                "no_room",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verdict"
        },
        "window": {
          "minimum": 1,
          "title": "Window",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "label",
        "kind",
        "tier",
        "window",
        "model",
        "asks"
      ],
      "title": "EvalPlanArm",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The arms, and ``running``: the id of the measurement that runs now, else null. Only one\nruns at a time, so while it does ``evals.start`` is refused.",
  "properties": {
    "arms": {
      "items": {
        "$ref": "#/$defs/EvalPlanArm"
      },
      "title": "Arms",
      "type": "array"
    },
    "asks": {
      "items": {
        "$ref": "#/$defs/EvalAsk"
      },
      "title": "Asks",
      "type": "array"
    },
    "running": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Running"
    }
  },
  "required": [
    "arms"
  ],
  "title": "EvalsPlanResult",
  "type": "object"
}
