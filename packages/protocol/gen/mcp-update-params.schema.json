{
  "$defs": {
    "McpOAuthConfig": {
      "additionalProperties": false,
      "description": "``oauth`` in an HTTP server's table: a client id for a server with no registration.",
      "properties": {
        "client_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Id"
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        }
      },
      "title": "McpOAuthConfig",
      "type": "object"
    },
    "McpServerConfig": {
      "additionalProperties": false,
      "description": "Every field of ``[mcp.<name>]``, as it goes over the wire.\n\nThe daemon's settings model has the same fields, and a test keeps the two\nequal. A value in ``env`` or ``headers`` names a secret as\n``keychain:mcp/<name>``, never the secret itself.",
      "properties": {
        "approval": {
          "default": "ask",
          "enum": [
            "ask",
            "read-only",
            "allow"
          ],
          "title": "Approval",
          "type": "string"
        },
        "args": {
          "items": {
            "type": "string"
          },
          "title": "Args",
          "type": "array"
        },
        "auto_enable": {
          "default": true,
          "title": "Auto Enable",
          "type": "boolean"
        },
        "command": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "cwd": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cwd"
        },
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "const": "on_demand",
              "type": "string"
            }
          ],
          "default": true,
          "title": "Enabled"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Env",
          "type": "object"
        },
        "env_passthrough": {
          "items": {
            "type": "string"
          },
          "title": "Env Passthrough",
          "type": "array"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Headers",
          "type": "object"
        },
        "oauth": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpOAuthConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "timeout_seconds": {
          "default": 120,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "tools": {
          "$ref": "#/$defs/McpToolFilterConfig"
        },
        "url": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "title": "McpServerConfig",
      "type": "object"
    },
    "McpToolFilterConfig": {
      "additionalProperties": false,
      "description": "``tools`` of ``[mcp.<name>]``: ``fnmatch`` patterns on the server's own tool names.\n\nAn empty ``include`` means every tool, and ``exclude`` wins.",
      "properties": {
        "exclude": {
          "items": {
            "type": "string"
          },
          "title": "Exclude",
          "type": "array"
        },
        "include": {
          "items": {
            "type": "string"
          },
          "title": "Include",
          "type": "array"
        }
      },
      "title": "McpToolFilterConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``mcp.update``. Replace the ``[mcp.<name>]`` table in the file that names it.\n\n``secrets`` are stored first, and only the ones sent change. A secret the\nserver already names and the request leaves out is kept, unless the request\nchanges the server's address (``url``, ``command``, ``args``, or ``cwd``):\nthen it must be sent again. ``new_name`` renames the server and moves its\n``mcp/<name>`` secrets.",
  "properties": {
    "config": {
      "$ref": "#/$defs/McpServerConfig"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "new_name": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,31}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "New Name"
    },
    "secrets": {
      "additionalProperties": {
        "format": "password",
        "type": "string",
        "writeOnly": true
      },
      "title": "Secrets",
      "type": "object"
    },
    "session_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    }
  },
  "required": [
    "name",
    "config"
  ],
  "title": "McpUpdateParams",
  "type": "object"
}
