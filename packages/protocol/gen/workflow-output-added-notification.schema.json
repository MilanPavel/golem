{
  "$defs": {
    "WorkflowOutputEvent": {
      "additionalProperties": false,
      "description": "The params of ``workflow.output.added``: the run marked a result with ``run.output``.\n\n``position`` is its place among the run's outputs (a run that is executed again sends the\nsame ones again, so a client keeps one for each). ``value`` is left out when it is large\n(see ``size``), and the client reads it with ``workflow.status``.",
      "properties": {
        "position": {
          "minimum": 0,
          "title": "Position",
          "type": "integer"
        },
        "size": {
          "default": 0,
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "value": {
          "default": null,
          "title": "Value"
        },
        "workflow_run_id": {
          "minLength": 1,
          "title": "Workflow Run Id",
          "type": "string"
        }
      },
      "required": [
        "workflow_run_id",
        "position"
      ],
      "title": "WorkflowOutputEvent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Server → every connection: ``workflow.output.added``. Not stored.\n\nThe run marked a result with ``run.output``; the page shows it at once.",
  "properties": {
    "jsonrpc": {
      "const": "2.0",
      "default": "2.0",
      "title": "Jsonrpc",
      "type": "string"
    },
    "method": {
      "const": "workflow.output.added",
      "default": "workflow.output.added",
      "title": "Method",
      "type": "string"
    },
    "params": {
      "$ref": "#/$defs/WorkflowOutputEvent"
    }
  },
  "required": [
