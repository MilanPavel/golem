{
  "$defs": {
    "ConsentCaps": {
      "additionalProperties": false,
      "description": "The caps of ``[budget]`` and what is spent, in USD. A cap that is not set is null.",
      "properties": {
        "daily_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Daily Usd"
        },
        "session_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Usd"
        },
        "spent_session": {
          "minimum": 0,
          "title": "Spent Session",
          "type": "number"
        },
        "spent_today": {
          "minimum": 0,
          "title": "Spent Today",
          "type": "number"
        }
      },
      "required": [
        "spent_session",
        "spent_today"
      ],
      "title": "ConsentCaps",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The run waits for the user's yes to a paid model. It is paused until\n``route.consent.answer``.\n\n``model_profile``, ``provider``, ``model`` and ``tier`` name the paid model that would\nrun. ``why`` is one plain sentence on why golem asks. ``estimated_usd`` is golem's\nestimate for this turn, null when the price is unknown. ``caps`` is set when a cap is.\n``alternatives`` are the answers the user may give: a spent cap leaves out ``session``.",
  "properties": {
    "alternatives": {
      "items": {
        "enum": [
          "session",
          "once",
          "local"
        ],
        "type": "string"
      },
      "title": "Alternatives",
      "type": "array"
    },
    "caps": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConsentCaps"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "estimated_usd": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Estimated Usd"
    },
    "model": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "model_profile": {
      "minLength": 1,
      "title": "Model Profile",
      "type": "string"
    },
    "provider": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider"
    },
    "tier": {
      "enum": [
        "local",
        "budget",
        "frontier"
      ],
      "title": "Tier",
      "type": "string"
    },
    "why": {
      "title": "Why",
      "type": "string"
    }
  },
  "required": [
    "model_profile",
    "tier",
    "why",
    "alternatives"
  ],
  "title": "RouteConsentNeededData",
  "type": "object"
}
