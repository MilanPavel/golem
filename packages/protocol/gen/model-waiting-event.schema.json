{
  "$defs": {
    "ModelWaitingData": {
      "additionalProperties": false,
      "description": "A chat call waits, or no longer waits, for its turn on a local model server.\n\nSent for the reply ``message_id`` only, so other sessions never show it. Stored only\nuntil its message completes. With ``waiting`` true, ``model`` and ``window`` say the call\nis loading ``model`` again with a larger ``window``, and the meter says so.",
      "properties": {
        "message_id": {
          "minLength": 1,
          "title": "Message Id",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "waiting": {
          "title": "Waiting",
          "type": "boolean"
        },
        "window": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window"
        }
      },
      "required": [
        "message_id",
        "waiting"
      ],
      "title": "ModelWaitingData",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A chat call waits for the local model. A live signal: ``message.completed`` replaces it.",
  "properties": {
    "data": {
      "$ref": "#/$defs/ModelWaitingData"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "seq": {
      "minimum": 1,
      "title": "Seq",
      "type": "integer"
    },
    "session_id": {
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "ts": {
      "minLength": 1,
      "title": "Ts",
      "type": "string"
    },
    "type": {
      "const": "model.waiting",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "seq",
    "session_id",
    "run_id",
    "ts",
    "type",
    "data"
  ],
  "title": "ModelWaitingEvent",
  "type": "object"
}
