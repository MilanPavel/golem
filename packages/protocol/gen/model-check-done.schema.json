{
  "$defs": {
    "ModelCheckCase": {
      "additionalProperties": false,
      "description": "How one case went. ``recovered``: the model wrote its call as text and golem read it.",
      "properties": {
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "ms": {
          "minimum": 0,
          "title": "Ms",
          "type": "integer"
        },
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "recovered"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "outcome",
        "ms"
      ],
      "title": "ModelCheckCase",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A check ended. ``error`` says why when ``ok`` is false, and then ``cases`` may be short.\n\n``verdict`` is ``reliable``, ``usable`` or ``not_recommended``. ``cost_usd`` is set for a\nmodel with a price, from the calls' usage.",
  "properties": {
    "cases": {
      "items": {
        "$ref": "#/$defs/ModelCheckCase"
      },
      "title": "Cases",
      "type": "array"
    },
    "cost_usd": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost Usd"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "passed": {
      "default": 0,
      "minimum": 0,
      "title": "Passed",
      "type": "integer"
    },
    "recovered": {
      "default": 0,
      "minimum": 0,
      "title": "Recovered",
      "type": "integer"
    },
    "ref": {
      "minLength": 3,
      "title": "Ref",
      "type": "string"
    },
    "total": {
      "default": 0,
      "minimum": 0,
      "title": "Total",
      "type": "integer"
    },
    "verdict": {
      "anyOf": [
        {
          "enum": [
            "reliable",
            "usable",
            "not_recommended"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verdict"
    }
  },
  "required": [
    "ref",
    "ok"
  ],
  "title": "ModelCheckDone",
  "type": "object"
}
