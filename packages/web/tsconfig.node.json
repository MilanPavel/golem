{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client"]
  },
  "include": ["vite.config.ts", "src/lint-rules.test.ts", "src/styles/no-arbitrary.test.ts", "src/styles/tokens.test.ts", "src/features/tab-status/favicon-tokens.test.ts", "src/pwa/*.test.ts", "scripts/gen-icons.ts"]
}
